# انسخ الملف ده باسم .env.local (محلي) أو ضيفهم في Vercel Environment Variables
# القيم دي بتاخدها من Firebase Console > Project Settings > بتاعك Web App

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# اسم الموقع اللي بيظهر في الهيدر والعنوان
NEXT_PUBLIC_SITE_NAME=أنمي هب
