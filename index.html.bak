<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modz Wep | منصة النقاط والمستويات</title>
    <meta name="description" content="منصة Modz Wep - نظام XP ومهام وإنجازات ومكافآت تفاعلية">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <!-- شاشة التحميل -->
    <div id="loadingScreen">
        <div class="loading-content">
            <div class="loading-logo">
                <i class="fas fa-spider"></i>
                <h1>MODZ WEP</h1>
                <span>مودز ويب</span>
            </div>
            <div class="loading-bar-container">
                <div class="loading-bar-track">
                    <div class="loading-bar-fill" id="loadingBarFill"></div>
                </div>
                <div class="loading-percentage" id="loadingPercentage">0%</div>
            </div>
            <div class="loading-status" id="loadingStatus">جارٍ التحميل...</div>
            <div class="loading-spinner"><i class="fas fa-circle-notch fa-spin"></i></div>
        </div>
    </div>

    <!-- شاشة المصادقة -->
    <div id="authScreen" class="auth-screen hidden">
        <div class="auth-container">
            <div class="auth-box">
                <div class="auth-logo">
                    <i class="fas fa-spider"></i>
                    <h1>MODZ WEP</h1>
                    <p>منصة التفاعل والنقاط</p>
                </div>
                <div class="auth-tabs">
                    <button class="auth-tab active" data-tab="login">تسجيل الدخول</button>
                    <button class="auth-tab" data-tab="register">إنشاء حساب</button>
                </div>
                <form id="loginForm" class="auth-form active">
                    <div class="input-group">
                        <i class="fas fa-envelope"></i>
                        <input type="email" id="loginEmail" placeholder="البريد الإلكتروني" required>
                    </div>
                    <div class="input-group">
                        <i class="fas fa-lock"></i>
                        <input type="password" id="loginPassword" placeholder="كلمة المرور" required>
                    </div>
                    <button type="submit" class="btn-primary btn-block">دخول</button>
                    <p class="auth-error" id="loginError"></p>
                </form>
                <form id="registerForm" class="auth-form">
                    <div class="input-group">
                        <i class="fas fa-user"></i>
                        <input type="text" id="registerUsername" placeholder="اسم المستخدم" required minlength="3">
                    </div>
                    <div class="input-group">
                        <i class="fas fa-envelope"></i>
                        <input type="email" id="registerEmail" placeholder="البريد الإلكتروني" required>
                    </div>
                    <div class="input-group">
                        <i class="fas fa-lock"></i>
                        <input type="password" id="registerPassword" placeholder="كلمة المرور" required minlength="6">
                    </div>
                    <button type="submit" class="btn-primary btn-block">إنشاء الحساب</button>
                    <p class="auth-error" id="registerError"></p>
                </form>
            </div>
        </div>
    </div>

    <!-- التطبيق الرئيسي -->
    <div id="mainApp" class="main-app hidden">
        <!-- شريط التنقل -->
        <nav class="navbar">
            <div class="nav-left">
                <div class="nav-logo"><i class="fas fa-spider"></i><span>MODZ WEP</span></div>
            </div>
            <div class="nav-tabs" id="navTabs">
                <button class="nav-tab active" data-section="dashboard"><i class="fas fa-home"></i> الرئيسية</button>
                <button class="nav-tab" data-section="profile"><i class="fas fa-user-circle"></i> ملفي</button>
                <button class="nav-tab" data-section="tasks"><i class="fas fa-tasks"></i> المهام</button>
                <button class="nav-tab" data-section="achievements"><i class="fas fa-trophy"></i> الإنجازات</button>
                <button class="nav-tab" data-section="leaderboard"><i class="fas fa-ranking-star"></i> المتصدرون</button>
                <button class="nav-tab" data-section="convert"><i class="fas fa-exchange-alt"></i> تحويل</button>
                <button class="nav-tab nav-tab-owner hidden" data-section="ownerPanel"><i class="fas fa-crown"></i> لوحة المالك</button>
            </div>
            <div class="nav-right">
                <div class="user-badge" id="userBadge">
                    <div class="user-avatar" id="userAvatar">م</div>
                    <div class="user-info-mini">
                        <span id="navUsername">مستخدم</span>
                        <span class="user-level-badge" id="navLevel">Lv.1</span>
                    </div>
                </div>
                <button class="btn-logout" id="logoutBtn" title="تسجيل الخروج"><i class="fas fa-sign-out-alt"></i></button>
            </div>
        </nav>

        <!-- المحتوى -->
        <div class="main-content">
            <!-- لوحة المستخدم -->
            <section id="dashboard" class="section active">
                <div class="dashboard-grid">
                    <div class="card level-card">
                        <div class="level-header">
                            <h2>مستواك</h2>
                            <span class="level-number" id="displayLevel">LEVEL 1</span>
                        </div>
                        <div class="level-progress-container">
                            <div class="level-progress-bar">
                                <div class="level-progress-fill" id="levelProgressFill"></div>
                            </div>
                            <div class="level-progress-text">
                                <span id="currentXP">0</span> / <span id="xpNeeded">100</span> XP
                            </div>
                        </div>
                        <div class="xp-stats">
                            <div class="xp-stat"><i class="fas fa-bolt"></i><span>إجمالي XP:</span><strong id="totalXP">0</strong></div>
                            <div class="xp-stat"><i class="fas fa-coins"></i><span>نقاط المكافأة:</span><strong id="bonusPoints">0</strong></div>
                        </div>
                        <div class="streak-indicator" id="streakIndicator">
                            <i class="fas fa-fire"></i>
                            <span>سلسلة الدخول: <strong id="streakCount">0</strong> يوم</span>
                        </div>
                        <button class="btn-daily-reward" id="dailyRewardBtn"><i class="fas fa-gift"></i> مكافأة اليوم</button>
                    </div>

                    <div class="card stats-card">
                        <h3><i class="fas fa-chart-bar"></i> إحصائياتك</h3>
                        <div class="mini-stats-grid">
                            <div class="mini-stat"><i class="fas fa-sign-in-alt"></i><span>مرات الدخول:</span><strong id="visitCount">0</strong></div>
                            <div class="mini-stat"><i class="fas fa-mouse-pointer"></i><span>التفاعلات:</span><strong id="clickCount">0</strong></div>
                            <div class="mini-stat"><i class="fas fa-check-circle"></i><span>مهام منجزة:</span><strong id="tasksDone">0</strong></div>
                            <div class="mini-stat"><i class="fas fa-ranking-star"></i><span>ترتيبك:</span><strong id="userRank">-</strong></div>
                        </div>
                    </div>

                    <div class="card convert-card">
                        <h3><i class="fas fa-exchange-alt"></i> تحويل XP إلى نقاط</h3>
                        <p class="convert-info">كل 100 XP = 10 نقاط مكافأة</p>
                        <div class="convert-form">
                            <input type="number" id="convertAmount" placeholder="أدخل كمية XP" min="100" step="100">
                            <button class="btn-secondary" id="convertBtn">تحويل</button>
                        </div>
                        <p class="convert-result" id="convertResult"></p>
                        <div class="convert-table">
                            <table>
                                <tr><th>XP</th><th>المكافأة</th></tr>
                                <tr><td>100</td><td>10</td></tr>
                                <tr><td>500</td><td>50</td></tr>
                                <tr><td>1,000</td><td>100</td></tr>
                                <tr><td>5,000</td><td>500</td></tr>
                                <tr><td>10,000</td><td>1,000</td></tr>
                            </table>
                        </div>
                    </div>

                    <div class="card activity-card">
                        <h3><i class="fas fa-history"></i> آخر الأنشطة</h3>
                        <div class="activity-list" id="userActivityLog">
                            <p class="empty-message">لا توجد أنشطة بعد</p>
                        </div>
                    </div>
                </div>

                <!-- إعلان -->
                <div class="ad-container">
                    <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-8692211557399903" data-ad-slot="1234567890" data-ad-format="auto"></ins>
                </div>
            </section>

            <!-- الملف الشخصي -->
            <section id="profile" class="section">
                <div class="profile-header-card card">
                    <div class="profile-avatar-big" id="profileAvatar">م</div>
                    <div class="profile-info">
                        <h2 id="profileUsername">اسم المستخدم</h2>
                        <p id="profileEmail">example@email.com</p>
                        <div class="profile-badges">
                            <span class="badge-level" id="profileLevelBadge">Lv.1</span>
                            <span class="badge-points" id="profilePointsBadge">0 نقطة</span>
                        </div>
                    </div>
                </div>
                <div class="profile-details-grid">
                    <div class="card">
                        <h4>معلومات الحساب</h4>
                        <p>تاريخ التسجيل: <span id="joinDate">-</span></p>
                        <p>آخر دخول: <span id="lastLogin">-</span></p>
                        <p>عدد الزيارات: <span id="profileVisits">0</span></p>
                    </div>
                    <div class="card">
                        <h4>الإنجازات المحققة</h4>
                        <div id="profileAchievements" class="profile-achievements-list"></div>
                    </div>
                    <div class="card">
                        <h4>رسم بياني للنشاط (آخر 7 أيام)</h4>
                        <div class="simple-chart" id="activityChart"></div>
                    </div>
                </div>
            </section>

            <!-- قسم المهام -->
            <section id="tasks" class="section">
                <div class="section-header">
                    <h2><i class="fas fa-tasks"></i> اكسب XP</h2>
                    <p>أكمل المهام لكسب نقاط الخبرة وارفع مستواك</p>
                </div>
                <div class="tasks-grid" id="tasksGrid"></div>
            </section>

            <!-- الإنجازات -->
            <section id="achievements" class="section">
                <div class="section-header">
                    <h2><i class="fas fa-trophy"></i> الإنجازات</h2>
                    <p>اجمع الإنجازات لتصبح أسطورة</p>
                </div>
                <div class="achievements-grid" id="achievementsGrid"></div>
            </section>

            <!-- لوحة المتصدرين -->
            <section id="leaderboard" class="section">
                <div class="section-header">
                    <h2><i class="fas fa-ranking-star"></i> لوحة المتصدرين</h2>
                    <p>أفضل المستخدمين من حيث XP</p>
                </div>
                <div class="leaderboard-container">
                    <table class="leaderboard-table">
                        <thead>
                            <tr><th>الترتيب</th><th>المستخدم</th><th>المستوى</th><th>XP</th><th>مهام</th><th>نقاط</th></tr>
                        </thead>
                        <tbody id="leaderboardBody"></tbody>
                    </table>
                </div>
            </section>

            <!-- قسم تحويل النقاط -->
            <section id="convert" class="section">
                <div class="convert-page">
                    <h2><i class="fas fa-coins"></i> تحويل XP إلى نقاط المكافأة</h2>
                    <p class="convert-info">يمكنك تحويل XP إلى نقاط مكافأة بمعدل 100 XP = 10 نقاط</p>
                    <div class="convert-form-large">
                        <input type="number" id="convertAmountPage" placeholder="أدخل كمية XP" min="100" step="100">
                        <button class="btn-primary" id="convertBtnPage">تحويل</button>
                    </div>
                    <p class="convert-result" id="convertResultPage"></p>
                </div>
            </section>

            <!-- لوحة المالك -->
            <section id="ownerPanel" class="section">
                <div class="section-header owner-header">
                    <h2><i class="fas fa-crown"></i> لوحة تحكم المالك</h2>
                    <p>إدارة شاملة للموقع والمستخدمين</p>
                </div>

                <!-- إحصائيات عامة -->
                <div class="owner-stats-grid">
                    <div class="owner-stat-card"><i class="fas fa-users"></i><span>إجمالي المستخدمين</span><strong id="oTotalUsers">0</strong></div>
                    <div class="owner-stat-card"><i class="fas fa-user-check"></i><span>المستخدمون النشطون</span><strong id="oActiveUsers">0</strong></div>
                    <div class="owner-stat-card"><i class="fas fa-eye"></i><span>إجمالي الزيارات</span><strong id="oTotalVisits">0</strong></div>
                    <div class="owner-stat-card"><i class="fas fa-bolt"></i><span>إجمالي XP موزع</span><strong id="oTotalXP">0</strong></div>
                    <div class="owner-stat-card"><i class="fas fa-mouse-pointer"></i><span>إجمالي النقرات</span><strong id="oTotalClicks">0</strong></div>
                    <div class="owner-stat-card"><i class="fas fa-calendar-day"></i><span>زيارات اليوم</span><strong id="oDailyVisits">0</strong></div>
                </div>

                <!-- إدارة المهام -->
                <div class="card owner-task-manager">
                    <h3><i class="fas fa-plus-circle"></i> إنشاء مهمة جديدة</h3>
                    <div class="task-create-form">
                        <input type="text" id="newTaskTitle" placeholder="عنوان المهمة">
                        <input type="text" id="newTaskDesc" placeholder="وصف المهمة">
                        <input type="number" id="newTaskXP" placeholder="XP" min="1" max="500">
                        <input type="number" id="newTaskMax" placeholder="مرات التنفيذ" min="1" max="100" value="1">
                        <input type="datetime-local" id="newTaskExpiry" placeholder="تاريخ الانتهاء">
                        <button class="btn-primary" id="createTaskBtn">إنشاء</button>
                    </div>
                </div>

                <!-- قائمة المهام -->
                <div class="card owner-tasks-list">
                    <h3><i class="fas fa-list"></i> المهام الحالية</h3>
                    <div id="ownerTasksList"></div>
                </div>

                <!-- إدارة المستخدمين -->
                <div class="card owner-users-manager">
                    <h3><i class="fas fa-search"></i> البحث عن مستخدم</h3>
                    <div class="user-search-form">
                        <input type="text" id="userSearchInput" placeholder="ابحث بالاسم أو البريد الإلكتروني...">
                        <button class="btn-secondary" id="searchUserBtn">بحث</button>
                    </div>
                    <div id="userSearchResults"></div>
                </div>

                <!-- سجل العمليات -->
                <div class="card owner-logs">
                    <h3><i class="fas fa-history"></i> سجل العمليات</h3>
                    <div id="ownerLogsList"></div>
                </div>

                <!-- إحصائيات زمنية -->
                <div class="card owner-time-stats">
                    <h3><i class="fas fa-chart-line"></i> الإحصائيات الزمنية</h3>
                    <div class="time-stats-tabs">
                        <button class="time-tab active" data-period="daily">يومي</button>
                        <button class="time-tab" data-period="weekly">أسبوعي</button>
                        <button class="time-tab" data-period="monthly">شهري</button>
                    </div>
                    <div id="timeStatsContent"></div>
                </div>

                <!-- إعلان -->
                <div class="ad-container">
                    <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-8692211557399903" data-ad-slot="9876543210" data-ad-format="auto"></ins>
                </div>
            </section>
        </div>

        <!-- زر واتساب -->
        <a href="https://wa.me/Modz.wep" class="whatsapp-float" target="_blank" rel="noopener" title="تواصل معنا">
            <i class="fab fa-whatsapp"></i>
        </a>

        <!-- إشعار -->
        <div id="notification" class="notification hidden">
            <i class="fas fa-check-circle"></i>
            <span id="notificationText"></span>
        </div>
    </div>

    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
    <script src="firebase-config.js"></script>
    <script src="app.js"></script>
</body>
</html>