<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="مساعد معرفي ذكي يعتمد على قاعدة معرفة قابلة للتوسع مع محرك بحث ذكي عربي">
    <meta property="og:title" content="المساعد المعرفي الذكي">
    <meta property="og:description" content="منصة ذكاء اصطناعي مبنية على قاعدة معرفة مع فهم عربي متقدم">
    <meta property="og:type" content="website">
    <title>المساعد المعرفي الذكي | AI Knowledge Assistant</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧠</text></svg>">
    <style>
:root {
    --bg: #f8fafc; --surface: #ffffff; --primary: #6366f1; --primary-hover: #4f46e5;
    --text: #1e293b; --text-secondary: #64748b; --border: #e2e8f0; --shadow: 0 1px 3px rgba(0,0,0,.08);
    --sidebar-bg: #1e293b; --sidebar-text: #e2e8f0; --sidebar-active: #6366f1; --sidebar-hover: #334155;
    --success: #10b981; --warning: #f59e0b; --error: #ef4444; --info: #3b82f6; --radius: 12px;
    --transition: .25s ease; --font: 'Segoe UI', Tahoma, 'Noto Kufi Arabic', sans-serif;
    --card-pad: 1.25rem; --gap: 1rem;
}
.dark-mode {
    --bg: #0f172a; --surface: #1e293b; --text: #f1f5f9; --text-secondary: #94a3b8;
    --border: #334155; --shadow: 0 1px 4px rgba(0,0,0,.3); --sidebar-bg: #020617;
    --sidebar-text: #cbd5e1; --sidebar-hover: #1e293b;
}
* { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; font-size:16px; }
body { font-family:var(--font); background:var(--bg); color:var(--text); line-height:1.6; min-height:100vh; transition:background var(--transition); }
a { color:var(--primary); text-decoration:none; }
button { cursor:pointer; font-family:inherit; border:none; background:none; color:inherit; }
input,select,textarea { font-family:inherit; font-size:.95rem; padding:.65rem .9rem; border:1px solid var(--border); border-radius:8px; background:var(--surface); color:var(--text); width:100%; transition:border .2s; }
input:focus,select:focus,textarea:focus { outline:2px solid var(--primary); border-color:var(--primary); }
textarea { resize:vertical; min-height:90px; }
label { font-weight:600; font-size:.88rem; margin-bottom:.35rem; display:inline-block; color:var(--text-secondary); }
.rtl { direction:rtl; } .ltr { direction:ltr; }

/* Layout */
.app-container { display:flex; min-height:100vh; }
.main-content { flex:1; margin-right:270px; transition:margin var(--transition); padding:1.5rem; max-width:1200px; margin-left:auto; }
.sidebar-collapsed .main-content { margin-right:80px; }
.sidebar-collapsed .sidebar { width:80px; }
.sidebar-collapsed .sidebar .nav-label, .sidebar-collapsed .sidebar .sidebar-logo span, .sidebar-collapsed .sidebar .badge { display:none; }
.sidebar-collapsed .sidebar .nav-link { justify-content:center; padding:.7rem; }
.sidebar-collapsed .sidebar .sidebar-logo { justify-content:center; }
.sidebar-collapsed .sidebar .sidebar-section-title { display:none; }

/* Sidebar */
.sidebar { width:270px; background:var(--sidebar-bg); color:var(--sidebar-text); height:100vh; position:fixed; top:0; right:0; z-index:100; transition:width var(--transition), transform var(--transition); display:flex; flex-direction:column; overflow-y:auto; box-shadow:2px 0 10px rgba(0,0,0,.1); }
.sidebar-logo { display:flex; align-items:center; gap:.6rem; padding:1.2rem 1.25rem; font-size:1.15rem; font-weight:700; border-bottom:1px solid rgba(255,255,255,.08); }
.sidebar-logo svg { width:30px; height:30px; flex-shrink:0; }
.sidebar-section { padding:.8rem 0 .3rem 0; }
.sidebar-section-title { font-size:.7rem; text-transform:uppercase; letter-spacing:.08em; color:var(--sidebar-text); opacity:.5; padding:0 1.25rem; margin-bottom:.4rem; }
.nav-link { display:flex; align-items:center; gap:.65rem; padding:.65rem 1.25rem; color:var(--sidebar-text); font-size:.9rem; transition:background .2s; border-right:3px solid transparent; width:100%; text-align:right; }
.nav-link:hover { background:var(--sidebar-hover); }
.nav-link.active { background:var(--sidebar-active); border-right-color:#fff; font-weight:600; }
.nav-link svg { width:19px; height:19px; flex-shrink:0; }
.badge { background:var(--error); color:#fff; font-size:.68rem; padding:.1rem .5rem; border-radius:99px; margin-right:auto; }
.sidebar-collapse-btn { position:absolute; bottom:15px; right:15px; background:rgba(255,255,255,.1); border-radius:50%; width:38px; height:38px; display:flex; align-items:center; justify-content:center; transition:background .2s; }
.sidebar-collapse-btn:hover { background:rgba(255,255,255,.2); }

/* Cards */
.card { background:var(--surface); border-radius:var(--radius); box-shadow:var(--shadow); padding:var(--card-pad); border:1px solid var(--border); }
.card-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem; flex-wrap:wrap; gap:.5rem; }
.card-title { font-size:1.1rem; font-weight:700; }
.card-subtitle { color:var(--text-secondary); font-size:.85rem; }

/* Stats Grid */
.stats-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:var(--gap); margin-bottom:1.5rem; }
.stat-card { background:var(--surface); border-radius:var(--radius); padding:1.1rem; box-shadow:var(--shadow); border:1px solid var(--border); text-align:center; transition:transform .2s; }
.stat-card:hover { transform:translateY(-2px); }
.stat-value { font-size:1.7rem; font-weight:800; color:var(--primary); }
.stat-label { font-size:.8rem; color:var(--text-secondary); margin-top:.2rem; }

/* Buttons */
.btn { display:inline-flex; align-items:center; gap:.45rem; padding:.6rem 1.2rem; border-radius:8px; font-weight:600; font-size:.9rem; transition:all .2s; border:1px solid transparent; white-space:nowrap; }
.btn-primary { background:var(--primary); color:#fff; } .btn-primary:hover { background:var(--primary-hover); transform:translateY(-1px); box-shadow:0 4px 12px rgba(99,102,241,.35); }
.btn-outline { border-color:var(--border); color:var(--text); background:var(--surface); } .btn-outline:hover { border-color:var(--primary); color:var(--primary); }
.btn-danger { background:var(--error); color:#fff; } .btn-danger:hover { background:#dc2626; }
.btn-success { background:var(--success); color:#fff; } .btn-success:hover { background:#059669; }
.btn-sm { padding:.4rem .8rem; font-size:.8rem; } .btn-lg { padding:.8rem 1.6rem; font-size:1rem; }
.btn-icon { width:36px; height:36px; padding:0; display:flex; align-items:center; justify-content:center; border-radius:8px; }
.btn:disabled { opacity:.5; cursor:not-allowed; transform:none !important; }

/* Forms */
.form-group { margin-bottom:1rem; }
.form-row { display:flex; gap:.8rem; flex-wrap:wrap; }
.form-row .form-group { flex:1; min-width:150px; }
.checkbox-group { display:flex; align-items:center; gap:.5rem; }
.checkbox-group input { width:auto; }

/* Tables */
.table-wrapper { overflow-x:auto; -webkit-overflow-scrolling:touch; }
table { width:100%; border-collapse:collapse; font-size:.88rem; }
th,td { padding:.7rem .85rem; text-align:right; border-bottom:1px solid var(--border); }
th { font-weight:700; color:var(--text-secondary); font-size:.78rem; text-transform:uppercase; letter-spacing:.03em; background:var(--bg); position:sticky; top:0; }
tr:hover td { background:rgba(99,102,241,.04); }

/* Chat */
.chat-container { display:flex; flex-direction:column; height:calc(100vh - 200px); min-height:400px; }
.chat-messages { flex:1; overflow-y:auto; padding:1rem; display:flex; flex-direction:column; gap:.8rem; }
.message { max-width:75%; padding:.7rem 1.1rem; border-radius:16px; font-size:.92rem; line-height:1.7; position:relative; word-wrap:break-word; }
.message.user { align-self:flex-end; background:var(--primary); color:#fff; border-bottom-left-radius:4px; }
.message.assistant { align-self:flex-start; background:var(--surface); border:1px solid var(--border); border-bottom-right-radius:4px; }
.message-actions { display:flex; gap:.4rem; margin-top:.5rem; font-size:.72rem; color:var(--text-secondary); }
.message-actions button { color:var(--text-secondary); font-size:.75rem; padding:.15rem .4rem; border-radius:4px; transition:color .2s; }
.message-actions button:hover { color:var(--primary); }
.chat-input-area { display:flex; gap:.6rem; padding:1rem 0; border-top:1px solid var(--border); }
.chat-input-area textarea { flex:1; min-height:44px; max-height:120px; border-radius:12px; padding:.65rem 1rem; resize:none; }
.thinking-indicator { display:flex; gap:.3rem; align-items:center; padding:.5rem 0; }
.thinking-indicator span { width:7px; height:7px; border-radius:50%; background:var(--primary); animation:bounce 1.2s infinite; }
.thinking-indicator span:nth-child(2){animation-delay:.15s;} .thinking-indicator span:nth-child(3){animation-delay:.3s;}
@keyframes bounce { 0%,60%,100% { transform:translateY(0); opacity:.4; } 30% { transform:translateY(-8px); opacity:1; } }

/* Modals */
.modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:999; display:flex; align-items:center; justify-content:center; animation:fadeIn .2s; }
.modal { background:var(--surface); border-radius:var(--radius); padding:1.5rem; max-width:600px; width:95%; max-height:90vh; overflow-y:auto; box-shadow:0 10px 40px rgba(0,0,0,.2); animation:slideUp .25s; }
.modal-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:1.2rem; }
.modal-title { font-size:1.15rem; font-weight:700; }
.modal-close { font-size:1.4rem; color:var(--text-secondary); width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center; transition:background .2s; }
.modal-close:hover { background:var(--border); }
@keyframes fadeIn { from{opacity:0} to{opacity:1} }
@keyframes slideUp { from{transform:translateY(25px);opacity:0} to{transform:translateY(0);opacity:1} }

/* Toast */
.toast-container { position:fixed; bottom:1.5rem; right:1.5rem; z-index:1000; display:flex; flex-direction:column; gap:.5rem; }
.toast { background:var(--surface); border-radius:8px; padding:.75rem 1.25rem; box-shadow:0 4px 16px rgba(0,0,0,.15); border-right:4px solid var(--success); font-size:.88rem; animation:slideInRight .3s; display:flex; align-items:center; gap:.5rem; }
.toast.error { border-right-color:var(--error); } .toast.warning { border-right-color:var(--warning); }
@keyframes slideInRight { from{transform:translateX(50px);opacity:0} to{transform:translateX(0);opacity:1} }

/* Empty State */
.empty-state { text-align:center; padding:2.5rem 1rem; color:var(--text-secondary); }
.empty-state svg { width:60px; height:60px; opacity:.3; margin-bottom:1rem; }
.empty-state p { font-size:1rem; }

/* Skeleton */
.skeleton { background:linear-gradient(90deg,var(--border) 25%,var(--bg) 50%,var(--border) 75%); background-size:200% 100%; animation:shimmer 1.5s infinite; border-radius:6px; }
@keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }

/* Tooltip */
[data-tooltip] { position:relative; }
[data-tooltip]:hover::after { content:attr(data-tooltip); position:absolute; bottom:100%; right:50%; transform:translateX(50%); background:var(--sidebar-bg); color:#fff; padding:.3rem .6rem; border-radius:4px; font-size:.7rem; white-space:nowrap; z-index:10; pointer-events:none; }

/* Progress bars */
.progress-bar { height:8px; background:var(--border); border-radius:99px; overflow:hidden; }
.progress-fill { height:100%; background:var(--primary); border-radius:99px; transition:width .4s; }

/* Tags */
.tag { display:inline-block; padding:.2rem .6rem; border-radius:99px; font-size:.72rem; font-weight:600; }
.tag-pending { background:#fef3c7; color:#92400e; } .tag-approved { background:#d1fae5; color:#065f46; }
.tag-rejected { background:#fee2e2; color:#991b1b; } .tag-active { background:#dbeafe; color:#1e40af; }
.tag-inactive { background:#e5e7eb; color:#6b7280; }

/* Landing Page */
.landing { min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:2rem; }
.landing-hero { font-size:2.6rem; font-weight:800; margin-bottom:.6rem; background:linear-gradient(135deg,var(--primary),#a855f7); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
.landing-sub { color:var(--text-secondary); font-size:1.15rem; max-width:600px; margin-bottom:2rem; }
.landing-features { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:1.2rem; max-width:900px; width:100%; margin-bottom:2rem; }
.landing-feature { padding:1.2rem; text-align:center; }

/* Responsive */
@media (max-width:768px) {
    .sidebar { transform:translateX(100%); }
    .sidebar.mobile-open { transform:translateX(0); }
    .main-content { margin-right:0; padding:.8rem; }
    .sidebar-collapsed .main-content { margin-right:0; }
    .sidebar-collapse-btn { display:none; }
    .message { max-width:90%; }
    .stats-grid { grid-template-columns:repeat(auto-fill,minmax(130px,1fr)); }
    .landing-hero { font-size:1.8rem; }
    .modal { width:98%; padding:1rem; }
    .form-row { flex-direction:column; }
    .hide-mobile { display:none !important; }
}
.mobile-toggle-btn { display:none; position:fixed; top:1rem; right:1rem; z-index:101; background:var(--primary); color:#fff; border-radius:50%; width:42px; height:42px; align-items:center; justify-content:center; box-shadow:0 4px 12px rgba(99,102,241,.4); }
@media (max-width:768px) { .mobile-toggle-btn { display:flex; } }

/* Debug panel */
.debug-panel { background:#1a1a2e; color:#e0e0e0; font-family:monospace; font-size:.75rem; padding:1rem; border-radius:8px; max-height:400px; overflow-y:auto; white-space:pre-wrap; }
.debug-line { padding:.15rem 0; border-bottom:1px solid #333; }

/* Scrollbar */
::-webkit-scrollbar { width:6px; height:6px; } ::-webkit-scrollbar-track { background:var(--bg); } ::-webkit-scrollbar-thumb { background:var(--border); border-radius:3px; } ::-webkit-scrollbar-thumb:hover { background:var(--text-secondary); }

/* System health dots */
.health-dot { width:10px; height:10px; border-radius:50%; display:inline-block; }
.health-operational { background:var(--success); } .health-warning { background:var(--warning); } .health-error { background:var(--error); }

/* Notification item */
.notif-item { display:flex; align-items:flex-start; gap:.7rem; padding:.6rem; border-radius:6px; transition:background .2s; }
.notif-item:hover { background:var(--bg); }
.notif-item.unread { border-right:3px solid var(--primary); }
.notif-dot { width:8px; height:8px; border-radius:50%; background:var(--primary); margin-top:.4rem; flex-shrink:0; }

/* Code blocks */
code { background:var(--bg); padding:.15rem .4rem; border-radius:4px; font-size:.82rem; font-family:'Courier New',monospace; }

/* Charts */
.chart-container { display:flex; align-items:flex-end; gap:.4rem; height:120px; padding:.5rem 0; }
.chart-bar { flex:1; background:var(--primary); border-radius:4px 4px 0 0; min-width:8px; transition:height .4s; position:relative; }
.chart-bar:hover { opacity:.8; }
.chart-bar-label { font-size:.65rem; text-align:center; color:var(--text-secondary); margin-top:.2rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
</style>
</head>
<body>

<!-- Mobile Toggle -->
<button class="mobile-toggle-btn" id="mobileToggle" aria-label="القائمة">☰</button>

<!-- App Container -->
<div class="app-container" id="appContainer">
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-logo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a4 4 0 014 4c0 .35-.05.69-.13 1.02A5.5 5.5 0 0119.5 12c0 .45-.05.88-.15 1.3A3.5 3.5 0 0116 19.5c0 .55-.13 1.07-.36 1.53A4.5 4.5 0 0112 17a4.5 4.5 0 01-3.64 4.03A3.5 3.5 0 018 19.5a5.5 5.5 0 01-4.35-4.7A4 4 0 014.5 8a4 4 0 013.63-4A4 4 0 0112 2z" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>المساعد الذكي</span>
        </div>
        <div class="sidebar-section"><p class="sidebar-section-title">الرئيسية</p>
            <button class="nav-link active" data-page="chat" data-tooltip="المحادثة"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg><span class="nav-label">المحادثة</span></button>
            <button class="nav-link" data-page="dashboard" data-tooltip="لوحة التحكم"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg><span class="nav-label">لوحة التحكم</span></button>
            <button class="nav-link" data-page="knowledge" data-tooltip="قاعدة المعرفة"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg><span class="nav-label">قاعدة المعرفة</span></button>
            <button class="nav-link" data-page="suggestions" data-tooltip="الاقتراحات"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg><span class="nav-label">الاقتراحات</span> <span class="badge" id="suggBadge" style="display:none;">0</span></button>
            <button class="nav-link" data-page="unanswered" data-tooltip="الأسئلة غير المجابة"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9 9a3 3 0 015.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg><span class="nav-label">أسئلة غير مجابة</span> <span class="badge" id="unansBadge" style="display:none;">0</span></button>
        </div>
        <div class="sidebar-section"><p class="sidebar-section-title">الإدارة</p>
            <button class="nav-link" data-page="analytics" data-tooltip="الإحصائيات"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10M12 20V4M6 20v-6"/></svg><span class="nav-label">الإحصائيات</span></button>
            <button class="nav-link" data-page="notifications" data-tooltip="الإشعارات"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg><span class="nav-label">الإشعارات</span> <span class="badge" id="notifBadge" style="display:none;">0</span></button>
            <button class="nav-link" data-page="audit" data-tooltip="سجل العمليات"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg><span class="nav-label">سجل العمليات</span></button>
            <button class="nav-link" data-page="upgrades" data-tooltip="مركز الترقيات"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5M5 12l7-7 7 7"/></svg><span class="nav-label">مركز الترقيات</span></button>
            <button class="nav-link" data-page="health" data-tooltip="حالة النظام"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg><span class="nav-label">حالة النظام</span></button>
            <button class="nav-link" data-page="settings" data-tooltip="الإعدادات"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg><span class="nav-label">الإعدادات</span></button>
        </div>
        <button class="sidebar-collapse-btn" id="sidebarCollapse" data-tooltip="طي/توسيع">◀</button>
    </aside>

    <!-- Main Content -->
    <main class="main-content" id="mainContent">
        <!-- Landing Page -->
        <div id="page-landing" class="landing" style="display:none;">
            <h1 class="landing-hero">المساعد المعرفي الذكي</h1>
            <p class="landing-sub">منصة ذكاء اصطناعي مبنية على قاعدة معرفة قابلة للتوسع، مع محرك بحث عربي متقدم يفهم السياق والذاكرة ويقدم إجابات موثوقة.</p>
            <div class="landing-features">
                <div class="card landing-feature"><strong>🔍 محرك بحث ذكي</strong><br><small style="color:var(--text-secondary)">تطبيع عربي، تشابه، سياق</small></div>
                <div class="card landing-feature"><strong>🧠 ذاكرة سياقية</strong><br><small style="color:var(--text-secondary)">ذاكرة محادثة وذاكرة مستخدم</small></div>
                <div class="card landing-feature"><strong>📚 قاعدة معرفة</strong><br><small style="color:var(--text-secondary)">محتوى موثوق ومنظم</small></div>
                <div class="card landing-feature"><strong>💡 اقتراحات المستخدمين</strong><br><small style="color:var(--text-secondary)">تحسين مستمر من المجتمع</small></div>
            </div>
            <div style="display:flex;gap:.8rem;flex-wrap:wrap;justify-content:center;">
                <button class="btn btn-primary btn-lg" id="landingChatBtn">ابدأ المحادثة</button>
                <button class="btn btn-outline btn-lg" id="landingLoginBtn">تسجيل الدخول</button>
            </div>
        </div>

        <!-- Auth Page -->
        <div id="page-auth" style="display:none;">
            <div class="card" style="max-width:420px;margin:3rem auto;">
                <h2 style="text-align:center;margin-bottom:1.5rem;" id="authTitle">تسجيل الدخول</h2>
                <div id="authForm">
                    <div class="form-group"><label>البريد الإلكتروني</label><input type="email" id="authEmail" placeholder="you@example.com" autocomplete="email"></div>
                    <div class="form-group"><label>كلمة المرور</label><input type="password" id="authPassword" placeholder="********" autocomplete="current-password"></div>
                    <div id="authConfirmGroup" style="display:none;" class="form-group"><label>تأكيد كلمة المرور</label><input type="password" id="authConfirm" placeholder="********" autocomplete="new-password"></div>
                    <button class="btn btn-primary" id="authSubmit" style="width:100%;justify-content:center;margin-top:.5rem;">تسجيل الدخول</button>
                    <p style="text-align:center;margin-top:1rem;font-size:.85rem;">
                        <a href="#" id="authToggleMode">إنشاء حساب جديد</a> |
                        <a href="#" id="authResetLink">نسيت كلمة المرور؟</a>
                    </p>
                </div>
                <div id="authResetForm" style="display:none;">
                    <p style="color:var(--text-secondary);margin-bottom:1rem;">أدخل بريدك الإلكتروني وسنرسل لك رابط استعادة كلمة المرور.</p>
                    <div class="form-group"><label>البريد الإلكتروني</label><input type="email" id="resetEmail" placeholder="you@example.com"></div>
                    <button class="btn btn-primary" id="resetSubmit" style="width:100%;justify-content:center;">إرسال الرابط</button>
                    <p style="text-align:center;margin-top:.8rem;"><a href="#" id="authBackToLogin">العودة لتسجيل الدخول</a></p>
                </div>
            </div>
        </div>

        <!-- Chat Page -->
        <div id="page-chat" style="display:none;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:.5rem;">
                <h2 style="font-size:1.3rem;">💬 المحادثة</h2>
                <div style="display:flex;gap:.5rem;">
                    <button class="btn btn-outline btn-sm" id="newChatBtn">+ محادثة جديدة</button>
                    <button class="btn btn-outline btn-sm" id="chatHistoryBtn">📋 سجل المحادثات</button>
                    <button class="btn btn-outline btn-sm" id="debugToggle" style="display:none;">🐛 تصحيح</button>
                </div>
            </div>
            <div class="card" style="padding:0;overflow:hidden;">
                <div class="chat-container" id="chatContainer">
                    <div class="chat-messages" id="chatMessages"></div>
                    <div id="debugPanel" class="debug-panel" style="display:none;margin:.5rem;"></div>
                    <div class="chat-input-area" style="padding:0 1rem;">
                        <textarea id="chatInput" placeholder="اكتب سؤالك هنا..." rows="1"></textarea>
                        <button class="btn btn-primary" id="sendBtn" style="border-radius:12px;">إرسال</button>
                    </div>
                </div>
            </div>
            <div id="chatSuggestImprove" style="display:none;margin-top:.8rem;text-align:center;">
                <button class="btn btn-outline btn-sm" id="suggestImproveBtn">💡 اقتراح تحسين</button>
            </div>
        </div>

        <!-- Dashboard Page -->
        <div id="page-dashboard" style="display:none;">
            <h2 style="font-size:1.3rem;margin-bottom:1rem;">📊 لوحة التحكم</h2>
            <div class="stats-grid" id="dashStats"></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;" class="dash-grid">
                <div class="card"><div class="card-header"><span class="card-title">الأسئلة الأكثر تكرارًا</span></div><div id="topQuestions" class="empty-state"></div></div>
                <div class="card"><div class="card-header"><span class="card-title">أكثر الإجابات استخدامًا</span></div><div id="topAnswers" class="empty-state"></div></div>
            </div>
            <div class="card" style="margin-top:1rem;"><div class="card-header"><span class="card-title">متوسط درجة الثقة</span></div><div id="avgConfidence" style="text-align:center;font-size:2rem;font-weight:800;color:var(--primary);">--</div></div>
            <div class="card" style="margin-top:1rem;"><div class="card-header"><span class="card-title">آخر النشاطات</span></div><div id="recentActivity" class="empty-state"></div></div>
        </div>

        <!-- Knowledge Page -->
        <div id="page-knowledge" style="display:none;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:.5rem;">
                <h2 style="font-size:1.3rem;">📚 قاعدة المعرفة</h2>
                <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
                    <button class="btn btn-primary btn-sm" id="addKnowledgeBtn">+ إضافة معرفة</button>
                    <button class="btn btn-outline btn-sm" id="exportKnowledgeBtn">📤 تصدير</button>
                    <button class="btn btn-outline btn-sm" id="importKnowledgeBtn">📥 استيراد</button>
                    <button class="btn btn-outline btn-sm" id="knowledgeTesterBtn">🧪 اختبار المحرك</button>
                    <button class="btn btn-outline btn-sm" id="mergeKnowledgeBtn">🔗 دمج المعرفة</button>
                </div>
            </div>
            <div class="card" style="margin-bottom:1rem;">
                <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
                    <input type="text" id="knowledgeSearch" placeholder="بحث في المعرفة..." style="max-width:300px;">
                    <select id="knowledgeFilter" style="max-width:160px;"><option value="all">الكل</option><option value="active">نشط</option><option value="inactive">غير نشط</option><option value="high">أولوية عالية</option><option value="low">أولوية منخفضة</option></select>
                </div>
            </div>
            <div class="card"><div class="table-wrapper"><table><thead><tr><th>السؤال</th><th>التصنيف</th><th>الأولوية</th><th>الحالة</th><th>الاستخدام</th><th>إجراءات</th></tr></thead><tbody id="knowledgeTableBody"></tbody></table></div><div id="knowledgeEmpty" class="empty-state" style="display:none;"><p>لا توجد عناصر معرفة بعد. أضف أول عنصر!</p></div></div>
        </div>

        <!-- Suggestions Page -->
        <div id="page-suggestions" style="display:none;">
            <h2 style="font-size:1.3rem;margin-bottom:1rem;">💡 الاقتراحات</h2>
            <div class="card"><div class="table-wrapper"><table><thead><tr><th>السؤال</th><th>الإجابة المقترحة</th><th>الحالة</th><th>التاريخ</th><th>إجراءات</th></tr></thead><tbody id="suggTableBody"></tbody></table></div><div id="suggEmpty" class="empty-state" style="display:none;"><p>لا توجد اقتراحات.</p></div></div>
        </div>

        <!-- Unanswered Page -->
        <div id="page-unanswered" style="display:none;">
            <h2 style="font-size:1.3rem;margin-bottom:1rem;">❓ الأسئلة غير المجابة</h2>
            <div class="card"><div class="table-wrapper"><table><thead><tr><th>السؤال</th><th>عدد المرات</th><th>أفضل تطابق</th><th>التاريخ</th><th>إجراء</th></tr></thead><tbody id="unansTableBody"></tbody></table></div><div id="unansEmpty" class="empty-state" style="display:none;"><p>لا توجد أسئلة غير مجابة.</p></div></div>
        </div>

        <!-- Analytics Page -->
        <div id="page-analytics" style="display:none;">
            <h2 style="font-size:1.3rem;margin-bottom:1rem;">📈 الإحصائيات</h2>
            <div class="stats-grid" id="analyticsStats"></div>
            <div class="card" style="margin-bottom:1rem;"><div class="card-header"><span class="card-title">نشاط الأسئلة (آخر 7 أيام)</span></div><div id="analyticsChart" class="chart-container"></div></div>
            <div class="card"><div class="card-header"><span class="card-title">نسبة الإجابات المفيدة</span></div><div id="helpfulRatio" style="text-align:center;font-size:1.8rem;font-weight:700;color:var(--success);">--</div></div>
            <div class="card" style="margin-top:1rem;"><div class="card-header"><span class="card-title">نشاط المشرفين</span></div><div id="adminActivity" class="empty-state"></div></div>
        </div>

        <!-- Notifications Page -->
        <div id="page-notifications" style="display:none;">
            <h2 style="font-size:1.3rem;margin-bottom:1rem;">🔔 الإشعارات</h2>
            <div class="card" id="notifList"></div>
        </div>

        <!-- Audit Logs Page -->
        <div id="page-audit" style="display:none;">
            <h2 style="font-size:1.3rem;margin-bottom:1rem;">📋 سجل العمليات</h2>
            <div class="card"><div class="table-wrapper"><table><thead><tr><th>العملية</th><th>المستخدم</th><th>النوع</th><th>العنصر</th><th>الوقت</th></tr></thead><tbody id="auditTableBody"></tbody></table></div><div id="auditEmpty" class="empty-state" style="display:none;"><p>لا توجد سجلات.</p></div></div>
        </div>

        <!-- Upgrades Page -->
        <div id="page-upgrades" style="display:none;">
            <h2 style="font-size:1.3rem;margin-bottom:1rem;">⚡ مركز الترقيات</h2>
            <div class="card" style="margin-bottom:1rem;"><div class="card-header"><span class="card-title">الإصدار الحالي</span><span id="currentVersionBadge" class="tag tag-active">v1.0.0</span></div><p id="versionDetails" style="color:var(--text-secondary);"></p></div>
            <div class="card" style="margin-bottom:1rem;"><div class="card-header"><span class="card-title">إضافة ترقية جديدة</span></div>
                <div class="form-row">
                    <div class="form-group"><label>الإصدار</label><input type="text" id="upVersion" placeholder="1.2.0"></div>
                    <div class="form-group"><label>العنوان</label><input type="text" id="upTitle" placeholder="تحسين محرك البحث"></div>
                    <div class="form-group"><label>الحالة</label><select id="upStatus"><option value="Completed">مكتمل</option><option value="In Progress">قيد التنفيذ</option><option value="Planned">مخطط</option></select></div>
                </div>
                <div class="form-group"><label>الوصف</label><textarea id="upDesc" placeholder="وصف الترقية..."></textarea></div>
                <div class="form-group"><label>النوع</label><select id="upType"><option value="Major">Major</option><option value="Minor" selected>Minor</option><option value="Patch">Patch</option></select></div>
                <button class="btn btn-primary" id="addUpgradeBtn">إضافة الترقية</button>
            </div>
            <div class="card"><div class="card-header"><span class="card-title">سجل الإصدارات</span></div><div id="upgradeHistory"></div></div>
        </div>

        <!-- System Health Page -->
        <div id="page-health" style="display:none;">
            <h2 style="font-size:1.3rem;margin-bottom:1rem;">🏥 حالة النظام</h2>
            <div class="stats-grid" id="healthGrid"></div>
            <div class="card"><div class="card-header"><span class="card-title">اختبار الاتصال</span></div><div id="healthTestResult"></div></div>
        </div>

        <!-- Settings Page -->
        <div id="page-settings" style="display:none;">
            <h2 style="font-size:1.3rem;margin-bottom:1rem;">⚙️ الإعدادات</h2>
            <div style="display:grid;gap:1rem;">
                <div class="card"><div class="card-header"><span class="card-title">إعدادات الذكاء</span></div>
                    <div class="form-row">
                        <div class="form-group"><label>الحد الأدنى للثقة</label><input type="number" id="sThreshold" min="0" max="100" value="60"></div>
                        <div class="form-group"><label>قوة الكلمات المفتاحية</label><input type="number" id="sKeywordWeight" min="0" max="100" value="30"></div>
                        <div class="form-group"><label>قوة التشابه</label><input type="number" id="sSimilarityWeight" min="0" max="100" value="25"></div>
                        <div class="form-group"><label>قوة السياق</label><input type="number" id="sContextWeight" min="0" max="100" value="15"></div>
                    </div>
                    <button class="btn btn-primary btn-sm" id="saveAISettings">حفظ</button>
                </div>
                <div class="card"><div class="card-header"><span class="card-title">إعدادات الموقع</span></div>
                    <div class="form-row">
                        <div class="form-group"><label>اسم الموقع</label><input type="text" id="sSiteName" value="المساعد المعرفي الذكي"></div>
                        <div class="form-group"><label>رسالة الترحيب</label><input type="text" id="sWelcome" value="مرحبًا! كيف يمكنني مساعدتك؟"></div>
                    </div>
                    <div class="form-group"><label>رسالة عدم المعرفة</label><input type="text" id="sNoAnswer" value="لا أملك معلومات مؤكدة عن هذا السؤال حاليًا."></div>
                    <div class="checkbox-group"><input type="checkbox" id="sDarkMode"><label for="sDarkMode">الوضع الداكن</label></div>
                    <button class="btn btn-primary btn-sm" id="saveSiteSettings">حفظ</button>
                </div>
                <div class="card"><div class="card-header"><span class="card-title">إعدادات الأمان</span></div>
                    <div class="checkbox-group"><input type="checkbox" id="sAllowRegister" checked><label for="sAllowRegister">السماح بالتسجيل</label></div>
                    <button class="btn btn-primary btn-sm" id="saveSecuritySettings" style="margin-top:.5rem;">حفظ</button>
                </div>
                <div class="card"><div class="card-header"><span class="card-title">وضع التصحيح (Debug Mode)</span></div>
                    <div class="checkbox-group"><input type="checkbox" id="sDebugMode"><label for="sDebugMode">تفعيل وضع التصحيح في المحادثة</label></div>
                    <button class="btn btn-primary btn-sm" id="saveDebugMode" style="margin-top:.5rem;">حفظ</button>
                </div>
                <div class="card"><div class="card-header"><span class="card-title">حسابي</span></div>
                    <p style="color:var(--text-secondary);margin-bottom:.5rem;" id="currentUserInfo"></p>
                    <button class="btn btn-danger btn-sm" id="logoutBtn">تسجيل الخروج</button>
                </div>
            </div>
        </div>
    </main>
</div>

<!-- Modals Container -->
<div id="modalContainer"></div>

<!-- Toast Container -->
<div class="toast-container" id="toastContainer"></div>

<!-- Hidden file input for import -->
<input type="file" id="importFileInput" accept=".json,.csv" style="display:none;">

<script type="module">
// ============ FIREBASE CONFIG ============
// ✏️ ضع إعدادات Firebase الخاصة بك هنا
import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js';
import { getAuth, createUserWithEmailAndPassword, signInWithEmailAndPassword, signOut, sendPasswordResetEmail, onAuthStateChanged } from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js';
import { getFirestore, collection, doc, getDoc, getDocs, addDoc, updateDoc, deleteDoc, query, where, orderBy, limit, serverTimestamp, increment, arrayUnion, runTransaction, writeBatch, setDoc } from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js';

const firebaseConfig = {
    apiKey: "YOUR_API_KEY",
    authDomain: "YOUR_PROJECT.firebaseapp.com",
    projectId: "YOUR_PROJECT_ID",
    storageBucket: "YOUR_PROJECT.appspot.com",
    messagingSenderId: "YOUR_SENDER_ID",
    appId: "YOUR_APP_ID"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
// ========================================

// ============ STATE ============
let currentUser = null;
let userRole = 'user'; // 'user', 'admin', 'moderator', 'owner'
let currentPage = 'landing';
let currentConversationId = null;
let conversations = [];
let currentChatMessages = [];
let isDarkMode = false;
let debugMode = false;
let settingsCache = {};
let knowledgeCache = [];
let knowledgeLoadedAt = 0;
let badgesLoaded = false;

// ============ UTILITIES ============
function toast(message, type = 'success') {
    const container = document.getElementById('toastContainer');
    const el = document.createElement('div');
    el.className = `toast ${type}`;
    el.textContent = message;
    container.appendChild(el);
    setTimeout(() => { el.style.opacity = '0'; el.style.transition = 'opacity .3s'; setTimeout(() => el.remove(), 350); }, 3000);
}

function showModal(html, options = {}) {
    const container = document.getElementById('modalContainer');
    container.innerHTML = `
        <div class="modal-overlay" id="modalOverlay">
            <div class="modal" role="dialog" aria-modal="true">
                <div class="modal-header">
                    <span class="modal-title">${options.title || ''}</span>
                    <button class="modal-close" aria-label="إغلاق">&times;</button>
                </div>
                <div>${html}</div>
            </div>
        </div>`;
    document.querySelector('.modal-close').addEventListener('click', closeModal);
    document.getElementById('modalOverlay').addEventListener('click', (e) => { if (e.target === e.currentTarget) closeModal(); });
    return container;
}
function closeModal() { document.getElementById('modalContainer').innerHTML = ''; }

function showLoading(show = true) {
    const btn = document.activeElement;
    if (btn && btn.tagName === 'BUTTON' && show) { btn.disabled = true; btn.dataset.original = btn.textContent; btn.textContent = '...'; }
    else if (btn && !show && btn.dataset.original) { btn.disabled = false; btn.textContent = btn.dataset.original; }
}

function formatDate(ts) {
    if (!ts) return '—';
    const d = ts.toDate ? ts.toDate() : new Date(ts);
    return d.toLocaleString('ar-EG', { year:'numeric', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' });
}
function timeAgo(ts) {
    if (!ts) return '—';
    const d = ts.toDate ? ts.toDate() : new Date(ts);
    const diff = Date.now() - d.getTime();
    const mins = Math.floor(diff / 60000);
    if (mins < 1) return 'الآن';
    if (mins < 60) return `منذ ${mins} دقيقة`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return `منذ ${hrs} ساعة`;
    const days = Math.floor(hrs / 24);
    if (days < 30) return `منذ ${days} يوم`;
    return formatDate(ts);
}
function escapeHtml(str) {
    if (!str) return '';
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
}
function generateId() { return Date.now().toString(36) + Math.random().toString(36).substr(2, 5); }
function safeText(text) { return escapeHtml(String(text || '')); }

// ============ ARABIC NORMALIZATION & KNOWLEDGE ENGINE ============
const ArabicNormalizer = {
    normalize(text) {
        if (!text) return '';
        let t = String(text);
        t = t.replace(/[\u064B-\u065F\u0670\u0640]/g, ''); // diacritics + tatweel
        t = t.replace(/[أإآا]/g, 'ا');
        t = t.replace(/ى/g, 'ي');
        t = t.replace(/ة/g, 'ه');
        t = t.replace(/ؤ/g, 'و');
        t = t.replace(/ئ/g, 'ي');
        t = t.replace(/[ًٌٍَُِّْ]/g, '');
        t = t.replace(/[؟?!،,؛;]/g, ' ');
        t = t.replace(/\s+/g, ' ').trim();
        return t;
    },
    removeStopWords(text) {
        const stopWords = ['في','من','الى','الي','عن','علي','على','ان','أن','ان','إن','كان','هذا','هذه','هو','هي','ما','ماذا','كيف','لماذا','اين','أين','متي','متى','هل','قد','لا','نعم','بلي','اي','أي','التي','الذي','الذين','ذلك','لكن','ثم','او','أو','و','ثم','حتى','بعد','قبل','عند','مع','بدون','دون','ليس','غير','كل','بعض','جدا','ايضا','أيضا'];
        let words = text.split(' ');
        return words.filter(w => !stopWords.includes(w) && w.length > 1).join(' ');
    },
    extractKeywords(text) {
        const normalized = this.normalize(text);
        const noStops = this.removeStopWords(normalized);
        return noStops.split(' ').filter(w => w.length > 1);
    },
    similarity(a, b) {
        const normA = this.normalize(a);
        const normB = this.normalize(b);
        if (normA === normB) return 1.0;
        const wordsA = new Set(this.extractKeywords(a));
        const wordsB = new Set(this.extractKeywords(b));
        if (wordsA.size === 0 && wordsB.size === 0) return 0;
        let intersection = 0;
        for (const w of wordsA) { if (wordsB.has(w)) intersection++; }
        const union = new Set([...wordsA, ...wordsB]).size;
        return union === 0 ? 0 : intersection / union;
    },
    partialMatch(a, b) {
        const kwA = this.extractKeywords(a);
        const kwB = this.extractKeywords(b);
        if (kwA.length === 0 || kwB.length === 0) return 0;
        let matches = 0;
        for (const w of kwA) {
            for (const w2 of kwB) {
                if (w.includes(w2) || w2.includes(w)) { matches++; break; }
            }
        }
        return matches / Math.max(kwA.length, kwB.length);
    }
};

const KnowledgeEngine = {
    threshold: 60,
    keywordWeight: 30,
    similarityWeight: 25,
    contextWeight: 15,
    memoryWeight: 10,
    aliasWeight: 20,

    async search(question, context = {}) {
        const normQ = ArabicNormalizer.normalize(question);
        const qKeywords = ArabicNormalizer.extractKeywords(question);
        if (qKeywords.length === 0) return { found: false, reason: 'empty_query' };

        let knowledge = [];
        if (knowledgeCache.length > 0 && Date.now() - knowledgeLoadedAt < 60000) {
            knowledge = knowledgeCache.filter(k => k.active !== false);
        } else {
            try {
                const snap = await getDocs(query(collection(db, 'knowledge'), where('active', '==', true)));
                knowledge = [];
                snap.forEach(d => { knowledge.push({ id: d.id, ...d.data() }); });
                knowledgeCache = knowledge;
                knowledgeLoadedAt = Date.now();
            } catch (e) { console.error('Error loading knowledge:', e); return { found: false, reason: 'db_error' }; }
        }

        if (knowledge.length === 0) return { found: false, reason: 'no_knowledge' };

        const scored = [];
        for (const k of knowledge) {
            let score = 0;
            let details = {};

            const qSim = ArabicNormalizer.similarity(question, k.question || '');
            const qPartial = ArabicNormalizer.partialMatch(question, k.question || '');
            const aliasMatches = [];
            const aliases = k.aliases || [];
            let bestAliasSim = 0;
            for (const a of aliases) {
                const s = ArabicNormalizer.similarity(question, a);
                if (s > bestAliasSim) bestAliasSim = s;
                aliasMatches.push({ alias: a, similarity: s });
            }
            const keywords = k.keywords || [];
            let kwMatches = 0;
            for (const kw of keywords) {
                const normKw = ArabicNormalizer.normalize(kw);
                if (normQ.includes(normKw) || qKeywords.some(qk => qk.includes(normKw) || normKw.includes(qk))) kwMatches++;
            }
            const kwRatio = keywords.length > 0 ? kwMatches / keywords.length : 0;

            let contextBonus = 0;
            if (context.recentTopics && k.category && context.recentTopics.includes(k.category)) contextBonus += 10;
            if (context.lastCategory === k.category) contextBonus += 5;
            if (context.memoryKeywords) {
                for (const mk of context.memoryKeywords) {
                    if ((k.question || '').includes(mk) || (k.answer || '').includes(mk)) contextBonus += 3;
                }
            }

            score = (qSim * 40) + (bestAliasSim * this.aliasWeight) + (kwRatio * this.keywordWeight) + (qPartial * this.similarityWeight) + (contextBonus * (this.contextWeight / 15)) + (k.priority || 0) * 0.5;

            details = { qSim, qPartial, bestAliasSim, kwRatio, kwMatches, contextBonus, aliases: aliasMatches, keywordsMatched: kwMatches, keywordsTotal: keywords.length };
            scored.push({ ...k, score: Math.min(100, Math.round(score * 10) / 10), details });
        }

        scored.sort((a, b) => b.score - a.score);

        const best = scored[0];
        const second = scored.length > 1 ? scored[1] : null;

        if (best && best.score >= this.threshold) {
            return { found: true, match: best, alternatives: scored.slice(0, 5), confidence: best.score, allScores: scored.slice(0, 10) };
        }
        if (best && second && Math.abs(best.score - second.score) < 5 && best.score >= this.threshold * 0.7) {
            return { found: true, match: best, alternatives: scored.slice(0, 5), confidence: best.score, needsClarification: true, allScores: scored.slice(0, 10) };
        }
        if (best && best.score >= this.threshold * 0.6) {
            return { found: true, match: best, confidence: best.score, lowConfidence: true, alternatives: scored.slice(0, 3), allScores: scored.slice(0, 10) };
        }
        return { found: false, reason: 'below_threshold', bestMatch: best, bestScore: best?.score || 0, allScores: scored.slice(0, 10) };
    },

    async checkSimilar(question, excludeId = null) {
        try {
            const snap = await getDocs(query(collection(db, 'knowledge'), where('active', '==', true)));
            const results = [];
            snap.forEach(d => {
                if (excludeId && d.id === excludeId) return;
                const sim = ArabicNormalizer.similarity(question, d.data().question || '');
                if (sim > 0.55) results.push({ id: d.id, similarity: sim, ...d.data() });
            });
            results.sort((a, b) => b.similarity - a.similarity);
            return results.slice(0, 5);
        } catch (e) { console.error(e); return []; }
    }
};

// ============ MEMORY SYSTEM ============
const MemorySystem = {
    conversationMemory: [],
    importantContext: [],
    userMemory: [],
    maxConversationLength: 20,
    maxImportantContext: 10,

    resetConversation() { this.conversationMemory = []; this.importantContext = []; },
    resetUser() { this.userMemory = []; },
    resetAll() { this.resetConversation(); this.resetUser(); },

    addToConversation(role, content, metadata = {}) {
        this.conversationMemory.push({ role, content, timestamp: Date.now(), ...metadata });
        if (this.conversationMemory.length > this.maxConversationLength) this.conversationMemory.shift();
    },
    addImportantContext(context) {
        if (!context) return;
        if (!this.importantContext.includes(context)) {
            this.importantContext.push(context);
            if (this.importantContext.length > this.maxImportantContext) this.importantContext.shift();
        }
    },
    addUserMemory(memory) {
        if (!memory) return;
        if (!this.userMemory.includes(memory)) this.userMemory.push(memory);
    },
    getRecentContext() {
        const recent = this.conversationMemory.slice(-6);
        return recent.map(r => r.content).join(' ');
    },
    getMemoryKeywords() {
        const all = [...this.conversationMemory.map(r => r.content), ...this.importantContext, ...this.userMemory];
        const keywords = new Set();
        for (const text of all) {
            const kws = ArabicNormalizer.extractKeywords(text);
            kws.forEach(k => keywords.add(k));
        }
        return [...keywords].slice(0, 15);
    },
    getContextObject() {
        return {
            recentTopics: this.importantContext.slice(-3),
            lastCategory: this.importantContext[this.importantContext.length - 1] || null,
            memoryKeywords: this.getMemoryKeywords(),
            conversationLength: this.conversationMemory.length
        };
    },
    async saveToFirestore(userId, memoryData) {
        if (!userId) return;
        try {
            const ref = doc(db, 'memories', userId);
            await setDoc(ref, {
                conversationMemory: this.conversationMemory.slice(-10),
                importantContext: this.importantContext,
                userMemory: this.userMemory,
                updatedAt: serverTimestamp()
            }, { merge: true });
        } catch (e) { console.error('Error saving memory:', e); }
    },
    async loadFromFirestore(userId) {
        if (!userId) return;
        try {
            const ref = doc(db, 'memories', userId);
            const snap = await getDoc(ref);
            if (snap.exists()) {
                const d = snap.data();
                this.conversationMemory = d.conversationMemory || [];
                this.importantContext = d.importantContext || [];
                this.userMemory = d.userMemory || [];
            }
        } catch (e) { console.error('Error loading memory:', e); }
    },
    async clearFirestore(userId) {
        if (!userId) return;
        try { await deleteDoc(doc(db, 'memories', userId)); } catch (e) { console.error(e); }
    },
    extractImportantFromQuestion(question) {
        const kws = ArabicNormalizer.extractKeywords(question);
        if (kws.length > 2) this.addImportantContext(kws.join(' '));
    }
};

// ============ AUTH ============
function setupAuth() {
    onAuthStateChanged(auth, async (user) => {
        if (user) {
            currentUser = user;
            await loadUserRole(user.uid);
            await MemorySystem.loadFromFirestore(user.uid);
            await loadSettings();
            showPage('chat');
            updateUIForUser();
        } else {
            currentUser = null;
            userRole = 'user';
            showPage('landing');
            updateUIForUser();
        }
    });
}

async function loadUserRole(uid) {
    try {
        const adminDoc = await getDoc(doc(db, 'admins', uid));
        if (adminDoc.exists()) {
            userRole = adminDoc.data().role || 'user';
            if (userRole === 'owner') userRole = 'owner';
            else if (userRole === 'admin') userRole = 'moderator';
        } else {
            userRole = 'user';
        }
        const debugBtn = document.getElementById('debugToggle');
        if (debugBtn) debugBtn.style.display = (userRole === 'owner' || userRole === 'moderator') ? 'inline-flex' : 'none';
    } catch (e) {
        console.error('Error loading role:', e);
        userRole = 'user';
    }
    updateSidebarForRole();
}

function updateSidebarForRole() {
    const isAdmin = userRole === 'owner' || userRole === 'moderator';
    document.querySelectorAll('[data-page]').forEach(btn => {
        const page = btn.dataset.page;
        const adminPages = ['dashboard', 'knowledge', 'suggestions', 'unanswered', 'analytics', 'notifications', 'audit', 'upgrades', 'health'];
        const ownerOnlyPages = ['audit', 'upgrades', 'health'];
        if (adminPages.includes(page)) {
            if (page === 'audit' || page === 'upgrades' || page === 'health') {
                btn.style.display = (userRole === 'owner') ? '' : 'none';
            } else {
                btn.style.display = isAdmin ? '' : 'none';
            }
        } else if (page === 'settings') {
            btn.style.display = currentUser ? '' : 'none';
        }
    });
}

function updateUIForUser() {
    const info = document.getElementById('currentUserInfo');
    if (info) info.textContent = currentUser ? `مسجل كـ: ${currentUser.email} (الدور: ${userRole})` : 'غير مسجل';
    if (currentUser && userRole !== 'user') {
        loadBadges();
    }
    if (currentUser) {
        loadConversationsList();
    }
}

// ============ SETTINGS ============
async function loadSettings() {
    try {
        const snap = await getDoc(doc(db, 'settings', 'ai'));
        if (snap.exists()) {
            const d = snap.data();
            KnowledgeEngine.threshold = d.threshold || 60;
            KnowledgeEngine.keywordWeight = d.keywordWeight || 30;
            KnowledgeEngine.similarityWeight = d.similarityWeight || 25;
            KnowledgeEngine.contextWeight = d.contextWeight || 15;
            settingsCache = d;
        }
        const siteSnap = await getDoc(doc(db, 'settings', 'site'));
        if (siteSnap.exists()) {
            const d = siteSnap.data();
            settingsCache.site = d;
            if (d.darkMode) applyDarkMode(true);
            document.getElementById('sSiteName') && (document.getElementById('sSiteName').value = d.siteName || '');
            document.getElementById('sWelcome') && (document.getElementById('sWelcome').value = d.welcomeMessage || '');
            document.getElementById('sNoAnswer') && (document.getElementById('sNoAnswer').value = d.noAnswerMessage || '');
        }
        const debugSnap = await getDoc(doc(db, 'settings', 'debug'));
        if (debugSnap.exists()) {
            debugMode = debugSnap.data().enabled || false;
            if (document.getElementById('sDebugMode')) document.getElementById('sDebugMode').checked = debugMode;
            const panel = document.getElementById('debugPanel');
            if (panel) panel.style.display = debugMode ? 'block' : 'none';
        }
    } catch (e) { console.error('Error loading settings:', e); }
}

function applyDarkMode(enable) {
    isDarkMode = enable;
    document.body.classList.toggle('dark-mode', enable);
}

// ============ SIDEBAR & NAVIGATION ============
function showPage(page) {
    currentPage = page;
    document.querySelectorAll('[id^="page-"]').forEach(el => el.style.display = 'none');
    const target = document.getElementById(`page-${page}`);
    if (target) target.style.display = '';
    document.querySelectorAll('.nav-link').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.page === page);
    });
    document.getElementById('sidebar')?.classList.remove('mobile-open');
    if (page === 'dashboard') loadDashboardData();
    if (page === 'knowledge') loadKnowledgeList();
    if (page === 'suggestions') loadSuggestions();
    if (page === 'unanswered') loadUnanswered();
    if (page === 'analytics') loadAnalytics();
    if (page === 'notifications') loadNotifications();
    if (page === 'audit') loadAuditLogs();
    if (page === 'upgrades') loadUpgrades();
    if (page === 'health') loadHealth();
    if (page === 'settings') loadSettingsIntoForm();
    if (page === 'chat') loadConversation();
}

function loadSettingsIntoForm() {
    document.getElementById('sThreshold').value = KnowledgeEngine.threshold;
    document.getElementById('sKeywordWeight').value = KnowledgeEngine.keywordWeight;
    document.getElementById('sSimilarityWeight').value = KnowledgeEngine.similarityWeight;
    document.getElementById('sContextWeight').value = KnowledgeEngine.contextWeight;
    document.getElementById('sDarkMode').checked = isDarkMode;
    if (settingsCache.site) {
        document.getElementById('sSiteName').value = settingsCache.site.siteName || '';
        document.getElementById('sWelcome').value = settingsCache.site.welcomeMessage || '';
        document.getElementById('sNoAnswer').value = settingsCache.site.noAnswerMessage || '';
    }
    if (document.getElementById('sDebugMode')) document.getElementById('sDebugMode').checked = debugMode;
}

// ============ CHAT ============
async function loadConversation() {
    const container = document.getElementById('chatMessages');
    if (!currentUser) { container.innerHTML = '<div class="empty-state"><p>يجب تسجيل الدخول للمحادثة.</p></div>'; return; }
    if (!currentConversationId) {
        container.innerHTML = '<div class="empty-state"><p>ابدأ محادثة جديدة أو اختر من السجل.</p></div>';
        return;
    }
    container.innerHTML = '<div class="skeleton" style="height:60px;margin-bottom:.5rem;"></div><div class="skeleton" style="height:60px;margin-bottom:.5rem;"></div>';
    try {
        const msgsSnap = await getDocs(query(collection(db, 'conversations', currentConversationId, 'messages'), orderBy('createdAt', 'asc')));
        currentChatMessages = [];
        container.innerHTML = '';
        msgsSnap.forEach(d => {
            const msg = { id: d.id, ...d.data() };
            currentChatMessages.push(msg);
            appendMessageToChat(msg);
        });
        container.scrollTop = container.scrollHeight;
    } catch (e) {
        console.error(e);
        container.innerHTML = '<div class="empty-state"><p>خطأ في تحميل المحادثة.</p></div>';
    }
}

function appendMessageToChat(msg) {
    const container = document.getElementById('chatMessages');
    const div = document.createElement('div');
    div.className = `message ${msg.role === 'user' ? 'user' : 'assistant'}`;
    div.id = `msg-${msg.id || generateId()}`;
    div.textContent = msg.content;
    if (msg.role === 'assistant') {
        const actions = document.createElement('div');
        actions.className = 'message-actions';
        actions.innerHTML = `
            <button title="نسخ">📋 نسخ</button>
            <button title="مفيد">👍 مفيد</button>
            <button title="غير مفيد">👎 غير مفيد</button>
            <button title="اقتراح تحسين">💡 تحسين</button>
        `;
        const copyBtn = actions.children[0];
        copyBtn.addEventListener('click', () => { navigator.clipboard.writeText(msg.content); toast('تم النسخ'); });
        const helpfulBtn = actions.children[1];
        helpfulBtn.addEventListener('click', async () => { await rateMessage(msg, true); });
        const unhelpfulBtn = actions.children[2];
        unhelpfulBtn.addEventListener('click', async () => { await rateMessage(msg, false); });
        const improveBtn = actions.children[3];
        improveBtn.addEventListener('click', () => { showSuggestImproveModal(msg); });
        div.appendChild(actions);
    }
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
}

async function rateMessage(msg, helpful) {
    if (!msg.id || !currentUser) return;
    try {
        await updateDoc(doc(db, 'conversations', currentConversationId, 'messages', msg.id), {
            rated: true,
            rating: helpful ? 'helpful' : 'unhelpful',
            ratedAt: serverTimestamp()
        });
        toast(helpful ? 'شكرًا لتقييمك!' : 'شكرًا لملاحظاتك');
        if (!helpful) {
            const improveBtn = document.querySelector(`#msg-${msg.id} .message-actions button[title="اقتراح تحسين"]`);
            if (improveBtn) improveBtn.click();
        }
    } catch (e) { console.error(e); toast('خطأ في التقييم', 'error'); }
}

async function sendMessage() {
    const input = document.getElementById('chatInput');
    const question = input.value.trim();
    if (!question || !currentUser) return;
    if (!currentConversationId) {
        await createNewConversation();
        if (!currentConversationId) return;
    }
    input.value = '';
    appendMessageToChat({ id: `temp-user-${Date.now()}`, role: 'user', content: question, createdAt: new Date() });

    const thinkingDiv = document.createElement('div');
    thinkingDiv.className = 'thinking-indicator';
    thinkingDiv.innerHTML = '<span></span><span></span><span></span>';
    thinkingDiv.id = 'thinking-indicator';
    document.getElementById('chatMessages').appendChild(thinkingDiv);
    document.getElementById('chatMessages').scrollTop = document.getElementById('chatMessages').scrollHeight;

    try {
        const userMsgRef = await addDoc(collection(db, 'conversations', currentConversationId, 'messages'), {
            role: 'user',
            content: question,
            createdAt: serverTimestamp()
        });
        MemorySystem.addToConversation('user', question);

        const context = MemorySystem.getContextObject();
        const result = await KnowledgeEngine.search(question, context);

        MemorySystem.extractImportantFromQuestion(question);

        let responseText = '';
        let knowledgeId = null;
        let confidence = 0;

        if (result.found && result.match) {
            responseText = result.match.answer;
            knowledgeId = result.match.id;
            confidence = result.confidence;
            MemorySystem.addToConversation('assistant', responseText, { knowledgeId, confidence });
            if (result.match.category) MemorySystem.addImportantContext(result.match.category);
        } else {
            const noAnswerMsg = settingsCache.site?.noAnswerMessage || 'لا أملك معلومات مؤكدة عن هذا السؤال حاليًا.';
            responseText = noAnswerMsg;
            MemorySystem.addToConversation('assistant', responseText, { noAnswer: true });

            // Save unanswered question
            try {
                const existing = await getDocs(query(collection(db, 'unansweredQuestions'), where('question', '==', question.toLowerCase())));
                if (existing.empty) {
                    await addDoc(collection(db, 'unansweredQuestions'), {
                        question: question.toLowerCase(),
                        userId: currentUser.uid,
                        bestScore: result.bestScore || 0,
                        count: 1,
                        createdAt: serverTimestamp(),
                        lastSeen: serverTimestamp()
                    });
                } else {
                    const docRef = existing.docs[0].ref;
                    await updateDoc(docRef, { count: increment(1), lastSeen: serverTimestamp() });
                }
            } catch (e) { console.error(e); }

            // Add notification for admin
            try {
                await addDoc(collection(db, 'notifications'), {
                    type: 'unanswered',
                    message: `سؤال غير مجاب: "${question.substring(0, 80)}"`,
                    read: false,
                    createdAt: serverTimestamp()
                });
            } catch (e) { console.error(e); }
        }

        await addDoc(collection(db, 'conversations', currentConversationId, 'messages'), {
            role: 'assistant',
            content: responseText,
            knowledgeId,
            confidence,
            createdAt: serverTimestamp()
        });
        await updateDoc(doc(db, 'conversations', currentConversationId), { updatedAt: serverTimestamp() });

        const thinkingEl = document.getElementById('thinking-indicator');
        if (thinkingEl) thinkingEl.remove();
        appendMessageToChat({ id: `assistant-${Date.now()}`, role: 'assistant', content: responseText, knowledgeId, confidence, createdAt: new Date() });

        if (debugMode) {
            const debugPanel = document.getElementById('debugPanel');
            if (debugPanel) {
                debugPanel.style.display = 'block';
                let debugText = `=== DEBUG INFO ===\nسؤال: ${question}\nمطبع: ${ArabicNormalizer.normalize(question)}\nكلمات: ${ArabicNormalizer.extractKeywords(question).join(', ')}\n`;
                if (result.allScores) {
                    debugText += `\n--- Top Matches ---\n`;
                    result.allScores.forEach((r, i) => {
                        debugText += `#${i + 1}: score=${r.score} q="${(r.question || '').substring(0, 50)}"\n`;
                    });
                }
                debugText += `\nتم الاختيار: ${result.found ? 'نعم' : 'لا'} الثقة: ${confidence}%\n`;
                if (result.found && result.match) debugText += `الإجابة من: ${result.match.id}\n`;
                debugText += `السياق: ${JSON.stringify(context)}\n`;
                debugPanel.textContent = debugText;
            }
        }
        MemorySystem.saveToFirestore(currentUser.uid, {});
    } catch (e) {
        console.error('Error sending message:', e);
        const thinkingEl = document.getElementById('thinking-indicator');
        if (thinkingEl) thinkingEl.remove();
        toast('حدث خطأ أثناء إرسال الرسالة', 'error');
    }
}

async function createNewConversation() {
    if (!currentUser) return;
    try {
        const ref = await addDoc(collection(db, 'conversations'), {
            userId: currentUser.uid,
            title: 'محادثة جديدة',
            createdAt: serverTimestamp(),
            updatedAt: serverTimestamp()
        });
        currentConversationId = ref.id;
        MemorySystem.resetConversation();
        await MemorySystem.saveToFirestore(currentUser.uid, {});
        document.getElementById('chatMessages').innerHTML = '';
        loadConversationsList();
        return ref.id;
    } catch (e) { console.error(e); toast('خطأ في إنشاء المحادثة', 'error'); return null; }
}

async function loadConversationsList() {
    if (!currentUser) return;
    try {
        const snap = await getDocs(query(collection(db, 'conversations'), where('userId', '==', currentUser.uid), orderBy('updatedAt', 'desc'), limit(20)));
        conversations = [];
        snap.forEach(d => conversations.push({ id: d.id, ...d.data() }));
    } catch (e) { console.error(e); }
}

function showConversationHistory() {
    if (!currentUser || conversations.length === 0) { toast('لا توجد محادثات سابقة', 'warning'); return; }
    let html = '<div style="max-height:400px;overflow-y:auto;">';
    conversations.forEach(c => {
        html += `<div style="display:flex;justify-content:space-between;align-items:center;padding:.5rem;border-bottom:1px solid var(--border);">
            <span>${escapeHtml(c.title || 'محادثة')} <small style="color:var(--text-secondary)">${timeAgo(c.updatedAt)}</small></span>
            <div style="display:flex;gap:.3rem;">
                <button class="btn btn-sm btn-outline" onclick="window._openConv('${c.id}')">فتح</button>
                <button class="btn btn-sm btn-danger" onclick="window._delConv('${c.id}')">حذف</button>
            </div>
        </div>`;
    });
    html += '</div>';
    showModal(html, { title: 'سجل المحادثات' });
    window._openConv = (id) => { currentConversationId = id; closeModal(); loadConversation(); };
    window._delConv = async (id) => {
        if (!confirm('حذف هذه المحادثة؟')) return;
        try { await deleteDoc(doc(db, 'conversations', id)); if (currentConversationId === id) { currentConversationId = null; document.getElementById('chatMessages').innerHTML = ''; } loadConversationsList(); closeModal(); toast('تم الحذف'); } catch (e) { toast('خطأ', 'error'); }
    };
}

function showSuggestImproveModal(msg) {
    const html = `
        <div class="form-group"><label>السؤال الأصلي</label><p style="background:var(--bg);padding:.5rem;border-radius:4px;">${escapeHtml(msg.content.substring(0, 100))}</p></div>
        <div class="form-group"><label>اقتراح تحسين الإجابة</label><textarea id="suggestText" placeholder="اكتب اقتراحك هنا..."></textarea></div>
        <div class="form-group"><label>سبب الاقتراح (اختياري)</label><input type="text" id="suggestReason" placeholder="لماذا هذا التحسين؟"></div>
        <button class="btn btn-primary" id="submitSuggestion">إرسال الاقتراح</button>`;
    showModal(html, { title: 'اقتراح تحسين' });
    document.getElementById('submitSuggestion').addEventListener('click', async () => {
        const text = document.getElementById('suggestText').value.trim();
        const reason = document.getElementById('suggestReason').value.trim();
        if (!text) { toast('اكتب اقتراحًا', 'warning'); return; }
        try {
            await addDoc(collection(db, 'suggestions'), {
                userId: currentUser.uid,
                question: msg.content.substring(0, 200),
                currentAnswer: msg.content,
                suggestedAnswer: text,
                reason,
                status: 'pending',
                createdAt: serverTimestamp()
            });
            closeModal();
            toast('تم إرسال الاقتراح');
        } catch (e) { console.error(e); toast('خطأ', 'error'); }
    });
}

// ============ KNOWLEDGE MANAGEMENT ============
async function loadKnowledgeList() {
    const tbody = document.getElementById('knowledgeTableBody');
    const empty = document.getElementById('knowledgeEmpty');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="6" class="skeleton" style="height:40px;"></td></tr>';
    try {
        let q = collection(db, 'knowledge');
        const filter = document.getElementById('knowledgeFilter')?.value || 'all';
        const searchTerm = document.getElementById('knowledgeSearch')?.value?.trim() || '';
        let snaps = [];
        if (filter === 'active') snaps = await getDocs(query(q, where('active', '==', true), orderBy('createdAt', 'desc'), limit(100)));
        else if (filter === 'inactive') snaps = await getDocs(query(q, where('active', '==', false), orderBy('createdAt', 'desc'), limit(100)));
        else snaps = await getDocs(query(q, orderBy('createdAt', 'desc'), limit(100)));

        let items = [];
        snaps.forEach(d => items.push({ id: d.id, ...d.data() }));
        if (searchTerm) {
            const normSearch = ArabicNormalizer.normalize(searchTerm);
            items = items.filter(k => ArabicNormalizer.normalize(k.question || '').includes(normSearch) || ArabicNormalizer.normalize(k.answer || '').includes(normSearch) || (k.keywords || []).some(kw => ArabicNormalizer.normalize(kw).includes(normSearch)));
        }
        tbody.innerHTML = '';
        if (items.length === 0) { empty.style.display = ''; return; }
        empty.style.display = 'none';
        for (const k of items) {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><strong>${escapeHtml((k.question || '').substring(0, 60))}</strong>${k.question && k.question.length > 60 ? '...' : ''}</td>
                <td>${escapeHtml(k.category || '—')}</td>
                <td>${k.priority || 0}</td>
                <td><span class="tag ${k.active !== false ? 'tag-active' : 'tag-inactive'}">${k.active !== false ? 'نشط' : 'غير نشط'}</span></td>
                <td>${k.usageCount || 0}</td>
                <td>
                    <button class="btn btn-sm btn-outline" onclick="window._editK('${k.id}')">تعديل</button>
                    <button class="btn btn-sm btn-danger" onclick="window._delK('${k.id}')">حذف</button>
                </td>`;
            tbody.appendChild(tr);
        }
        window._editK = async (id) => { await showEditKnowledge(id); };
        window._delK = async (id) => {
            if (!confirm('حذف هذا العنصر؟')) return;
            try { await deleteDoc(doc(db, 'knowledge', id)); toast('تم الحذف'); loadKnowledgeList(); await logAudit('Deleted knowledge', id); } catch (e) { toast('خطأ', 'error'); }
        };
    } catch (e) { console.error(e); tbody.innerHTML = ''; empty.style.display = ''; }
}

async function showAddKnowledge() {
    const html = `
        <div class="form-group"><label>السؤال الأساسي *</label><input type="text" id="kQuestion" placeholder="كيف أغير كلمة المرور؟"></div>
        <div class="form-group"><label>الإجابة *</label><textarea id="kAnswer" placeholder="الإجابة الكاملة..."></textarea></div>
        <div class="form-group"><label>الكلمات المشابهة (aliases) - افصل بسطر جديد</label><textarea id="kAliases" placeholder="ازاي اغير الباسورد&#10;طريقة تغيير كلمة السر"></textarea></div>
        <div class="form-group"><label>الكلمات المفتاحية - افصل بفاصلة</label><input type="text" id="kKeywords" placeholder="تغيير, كلمة المرور, الباسورد"></div>
        <div class="form-row">
            <div class="form-group"><label>التصنيف</label><input type="text" id="kCategory" placeholder="Account" value="General"></div>
            <div class="form-group"><label>الأولوية (1-10)</label><input type="number" id="kPriority" min="1" max="10" value="5"></div>
        </div>
        <div class="form-group"><label>ملاحظات داخلية</label><textarea id="kNotes" placeholder="ملاحظات للمشرفين فقط"></textarea></div>
        <div id="similarWarnings"></div>
        <button class="btn btn-primary" id="saveKnowledgeBtn">حفظ المعرفة</button>`;
    showModal(html, { title: 'إضافة معرفة جديدة' });
    document.getElementById('kQuestion').addEventListener('blur', async () => {
        const q = document.getElementById('kQuestion').value.trim();
        if (!q) return;
        const similar = await KnowledgeEngine.checkSimilar(q);
        const warnDiv = document.getElementById('similarWarnings');
        if (similar.length > 0) {
            warnDiv.innerHTML = `<div style="background:var(--warning);color:#fff;padding:.6rem;border-radius:6px;margin-bottom:.5rem;">⚠️ يوجد ${similar.length} عنصر مشابه:</div>`;
            similar.forEach(s => {
                warnDiv.innerHTML += `<p style="font-size:.8rem;padding:.3rem;border-bottom:1px solid var(--border);">- ${escapeHtml(s.question.substring(0, 60))} (تشابه: ${Math.round(s.similarity * 100)}%)</p>`;
            });
        } else { warnDiv.innerHTML = ''; }
    });
    document.getElementById('saveKnowledgeBtn').addEventListener('click', async () => {
        const q = document.getElementById('kQuestion').value.trim();
        const ans = document.getElementById('kAnswer').value.trim();
        if (!q || !ans) { toast('السؤال والإجابة مطلوبان', 'warning'); return; }
        const similar = await KnowledgeEngine.checkSimilar(q);
        if (similar.length > 0 && !confirm(`يوجد ${similar.length} عنصر مشابه. هل تريد إنشاء عنصر جديد رغم ذلك؟`)) return;
        const aliases = (document.getElementById('kAliases').value || '').split('\n').map(s => s.trim()).filter(Boolean);
        const keywords = (document.getElementById('kKeywords').value || '').split(',').map(s => s.trim()).filter(Boolean);
        try {
            await addDoc(collection(db, 'knowledge'), {
                question: q,
                answer: ans,
                aliases,
                keywords,
                category: document.getElementById('kCategory').value.trim() || 'General',
                priority: parseInt(document.getElementById('kPriority').value) || 5,
                notes: document.getElementById('kNotes').value.trim(),
                confidence: 90,
                status: 'approved',
                createdBy: currentUser.uid,
                createdAt: serverTimestamp(),
                updatedAt: serverTimestamp(),
                version: 1,
                active: true,
                usageCount: 0,
                helpfulCount: 0,
                unhelpfulCount: 0
            });
            closeModal();
            toast('تمت الإضافة بنجاح');
            await logAudit('Created knowledge', 'new');
            loadKnowledgeList();
        } catch (e) { console.error(e); toast('خطأ في الحفظ', 'error'); }
    });
}

async function showEditKnowledge(id) {
    try {
        const snap = await getDoc(doc(db, 'knowledge', id));
        if (!snap.exists()) { toast('غير موجود', 'error'); return; }
        const k = snap.data();
        const html = `
            <div class="form-group"><label>السؤال الأساسي</label><input type="text" id="kQuestion" value="${escapeHtml(k.question || '')}"></div>
            <div class="form-group"><label>الإجابة</label><textarea id="kAnswer">${escapeHtml(k.answer || '')}</textarea></div>
            <div class="form-group"><label>الكلمات المشابهة</label><textarea id="kAliases">${escapeHtml((k.aliases || []).join('\n'))}</textarea></div>
            <div class="form-group"><label>الكلمات المفتاحية</label><input type="text" id="kKeywords" value="${escapeHtml((k.keywords || []).join(', '))}"></div>
            <div class="form-row">
                <div class="form-group"><label>التصنيف</label><input type="text" id="kCategory" value="${escapeHtml(k.category || '')}"></div>
                <div class="form-group"><label>الأولوية</label><input type="number" id="kPriority" value="${k.priority || 5}" min="1" max="10"></div>
            </div>
            <div class="form-group"><label>ملاحظات</label><textarea id="kNotes">${escapeHtml(k.notes || '')}</textarea></div>
            <div class="checkbox-group"><input type="checkbox" id="kActive" ${k.active !== false ? 'checked' : ''}><label for="kActive">نشط</label></div>
            <button class="btn btn-primary" id="updateKnowledgeBtn">تحديث</button>`;
        showModal(html, { title: 'تعديل المعرفة' });
        document.getElementById('updateKnowledgeBtn').addEventListener('click', async () => {
            const updatedData = {
                question: document.getElementById('kQuestion').value.trim(),
                answer: document.getElementById('kAnswer').value.trim(),
                aliases: document.getElementById('kAliases').value.split('\n').map(s => s.trim()).filter(Boolean),
                keywords: document.getElementById('kKeywords').value.split(',').map(s => s.trim()).filter(Boolean),
                category: document.getElementById('kCategory').value.trim(),
                priority: parseInt(document.getElementById('kPriority').value) || 5,
                notes: document.getElementById('kNotes').value.trim(),
                active: document.getElementById('kActive').checked,
                updatedBy: currentUser.uid,
                updatedAt: serverTimestamp(),
                version: (k.version || 1) + 1
            };
            try {
                await updateDoc(doc(db, 'knowledge', id), updatedData);
                // Save version history
                await addDoc(collection(db, 'knowledgeVersions'), {
                    knowledgeId: id,
                    version: k.version || 1,
                    question: k.question,
                    answer: k.answer,
                    updatedBy: k.updatedBy || k.createdBy,
                    updatedAt: k.updatedAt || k.createdAt,
                    archivedAt: serverTimestamp()
                });
                closeModal();
                toast('تم التحديث');
                await logAudit('Updated knowledge', id);
                loadKnowledgeList();
            } catch (e) { console.error(e); toast('خطأ', 'error'); }
        });
    } catch (e) { console.error(e); toast('خطأ في التحميل', 'error'); }
}

async function exportKnowledge() {
    try {
        const snap = await getDocs(collection(db, 'knowledge'));
        const items = [];
        snap.forEach(d => items.push({ id: d.id, ...d.data() }));
        const json = JSON.stringify(items, null, 2);
        const blob = new Blob([json], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = `knowledge_export_${Date.now()}.json`;
        a.click(); URL.revokeObjectURL(url);
        toast('تم التصدير');
    } catch (e) { console.error(e); toast('خطأ في التصدير', 'error'); }
}

function importKnowledge() {
    document.getElementById('importFileInput').click();
    document.getElementById('importFileInput').onchange = async (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const text = await file.text();
        try {
            const data = JSON.parse(text);
            if (!Array.isArray(data)) { toast('صيغة غير صحيحة', 'error'); return; }
            let previewHtml = `<p>سيتم استيراد ${data.length} عنصر. تأكد من البيانات:</p><div style="max-height:300px;overflow-y:auto;">`;
            data.forEach((item, i) => {
                previewHtml += `<p style="font-size:.8rem;padding:.2rem;">${i + 1}. ${escapeHtml((item.question || '').substring(0, 50))}</p>`;
            });
            previewHtml += `</div><button class="btn btn-primary" id="confirmImportBtn">تأكيد الاستيراد</button>`;
            showModal(previewHtml, { title: 'معاينة الاستيراد' });
            document.getElementById('confirmImportBtn').addEventListener('click', async () => {
                let imported = 0;
                for (const item of data) {
                    if (!item.question || !item.answer) continue;
                    await addDoc(collection(db, 'knowledge'), {
                        question: item.question,
                        answer: item.answer,
                        aliases: item.aliases || [],
                        keywords: item.keywords || [],
                        category: item.category || 'General',
                        priority: item.priority || 5,
                        active: item.active !== false,
                        createdBy: currentUser.uid,
                        createdAt: serverTimestamp(),
                        updatedAt: serverTimestamp(),
                        version: 1,
                        usageCount: item.usageCount || 0,
                        helpfulCount: item.helpfulCount || 0,
                        unhelpfulCount: item.unhelpfulCount || 0
                    });
                    imported++;
                }
                closeModal();
                toast(`تم استيراد ${imported} عنصر`);
                loadKnowledgeList();
            });
        } catch (e) { toast('خطأ في قراءة الملف', 'error'); }
    };
}

function showKnowledgeTester() {
    const html = `
        <div class="form-group"><label>اكتب سؤالًا للاختبار</label><input type="text" id="testQuestion" placeholder="ازاي اغير الباسورد؟"></div>
        <button class="btn btn-primary" id="runTestBtn">تشغيل الاختبار</button>
        <div id="testResults" style="margin-top:1rem;"></div>`;
    showModal(html, { title: 'اختبار محرك المعرفة' });
    document.getElementById('runTestBtn').addEventListener('click', async () => {
        const q = document.getElementById('testQuestion').value.trim();
        if (!q) { toast('اكتب سؤالًا', 'warning'); return; }
        const resultDiv = document.getElementById('testResults');
        resultDiv.innerHTML = '<div class="skeleton" style="height:100px;"></div>';
        const result = await KnowledgeEngine.search(q, {});
        resultDiv.innerHTML = '';
        if (result.found && result.match) {
            resultDiv.innerHTML = `
                <p><strong>أفضل تطابق:</strong> ${escapeHtml(result.match.question)}</p>
                <p><strong>النتيجة:</strong> ${result.confidence}%</p>
                <p><strong>الإجابة:</strong> ${escapeHtml(result.match.answer.substring(0, 200))}</p>
                <p><strong>الكلمات المفتاحية المطابقة:</strong> ${result.match.details?.keywordsMatched || 0} من ${result.match.details?.keywordsTotal || 0}</p>`;
        } else {
            resultDiv.innerHTML = `<p style="color:var(--warning);">لم يتم العثور على تطابق قوي. أفضل نتيجة: ${result.bestScore || 0}% (${escapeHtml((result.bestMatch?.question || 'لا شيء').substring(0, 50))})</p>`;
        }
        if (result.allScores && result.allScores.length > 0) {
            let scoresHtml = '<p><strong>جميع النتائج:</strong></p>';
            result.allScores.forEach((r, i) => {
                scoresHtml += `<p style="font-size:.8rem;">${i + 1}. ${escapeHtml(r.question.substring(0, 40))} - ${r.score}%</p>`;
            });
            resultDiv.innerHTML += scoresHtml;
        }
    });
}

function showMergeKnowledge() {
    const html = `
        <div class="form-group"><label>اختر العنصر الأول</label><input type="text" id="mergeFirst" placeholder="بحث..."></div>
        <div class="form-group"><label>اختر العنصر الثاني</label><input type="text" id="mergeSecond" placeholder="بحث..."></div>
        <div id="mergeResults"></div>
        <button class="btn btn-primary" id="doMergeBtn" style="display:none;">تنفيذ الدمج</button>`;
    showModal(html, { title: 'دمج المعرفة' });
    let mergeData = null;
    const searchAndSelect = async (inputId, target) => {
        const term = document.getElementById(inputId).value.trim();
        if (!term) return;
        const snaps = await getDocs(query(collection(db, 'knowledge'), limit(20)));
        const results = [];
        snaps.forEach(d => {
            const data = d.data();
            if (ArabicNormalizer.normalize(data.question || '').includes(ArabicNormalizer.normalize(term))) results.push({ id: d.id, ...data });
        });
        const container = document.getElementById('mergeResults');
        container.innerHTML = results.map((r, i) => `<p style="padding:.3rem;cursor:pointer;border-bottom:1px solid var(--border);" onclick="window._selectMerge(${i}, '${r.id}', '${target}')">${escapeHtml(r.question.substring(0, 60))}</p>`).join('');
        window._selectMerge = (idx, id, target) => {
            if (!mergeData) mergeData = {};
            mergeData[target] = results.find(r => r.id === id);
            const btn = document.getElementById('doMergeBtn');
            if (mergeData.first && mergeData.second) {
                btn.style.display = '';
                btn.onclick = async () => {
                    const a = mergeData.first, b = mergeData.second;
                    const mergedQuestion = a.question || b.question;
                    const mergedAnswer = a.answer || b.answer;
                    const mergedAliases = [...new Set([...(a.aliases || []), ...(b.aliases || [])])];
                    const mergedKeywords = [...new Set([...(a.keywords || []), ...(b.keywords || [])])];
                    try {
                        await addDoc(collection(db, 'knowledge'), {
                            question: mergedQuestion,
                            answer: mergedAnswer,
                            aliases: mergedAliases,
                            keywords: mergedKeywords,
                            category: a.category || b.category || 'General',
                            priority: Math.max(a.priority || 5, b.priority || 5),
                            createdBy: currentUser.uid,
                            createdAt: serverTimestamp(),
                            updatedAt: serverTimestamp(),
                            version: 1,
                            active: true,
                            mergedFrom: [a.id, b.id],
                            usageCount: (a.usageCount || 0) + (b.usageCount || 0)
                        });
                        await updateDoc(doc(db, 'knowledge', a.id), { active: false });
                        await updateDoc(doc(db, 'knowledge', b.id), { active: false });
                        closeModal();
                        toast('تم الدمج بنجاح');
                        loadKnowledgeList();
                    } catch (e) { console.error(e); toast('خطأ في الدمج', 'error'); }
                };
            }
        };
    };
    document.getElementById('mergeFirst').addEventListener('blur', (e) => searchAndSelect('mergeFirst', 'first'));
    document.getElementById('mergeSecond').addEventListener('blur', (e) => searchAndSelect('mergeSecond', 'second'));
}

// ============ SUGGESTIONS ============
async function loadSuggestions() {
    const tbody = document.getElementById('suggTableBody');
    const empty = document.getElementById('suggEmpty');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="5" class="skeleton" style="height:40px;"></td></tr>';
    try {
        const snap = await getDocs(query(collection(db, 'suggestions'), orderBy('createdAt', 'desc'), limit(50)));
        const items = [];
        snap.forEach(d => items.push({ id: d.id, ...d.data() }));
        tbody.innerHTML = '';
        if (items.length === 0) { empty.style.display = ''; return; }
        empty.style.display = 'none';
        for (const s of items) {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${escapeHtml((s.question || '').substring(0, 50))}</td>
                <td>${escapeHtml((s.suggestedAnswer || '').substring(0, 50))}</td>
                <td><span class="tag ${s.status === 'pending' ? 'tag-pending' : s.status === 'approved' ? 'tag-approved' : 'tag-rejected'}">${s.status === 'pending' ? 'معلق' : s.status === 'approved' ? 'مقبول' : 'مرفوض'}</span></td>
                <td>${timeAgo(s.createdAt)}</td>
                <td>${s.status === 'pending' ? `<button class="btn btn-sm btn-success" onclick="window._approveSugg('${s.id}')">قبول</button> <button class="btn btn-sm btn-danger" onclick="window._rejectSugg('${s.id}')">رفض</button>` : '—'}</td>`;
            tbody.appendChild(tr);
        }
        window._approveSugg = async (id) => { await handleSuggestion(id, true); };
        window._rejectSugg = async (id) => { await handleSuggestion(id, false); };
    } catch (e) { console.error(e); tbody.innerHTML = ''; empty.style.display = ''; }
}

async function handleSuggestion(id, approve) {
    if (userRole !== 'owner' && userRole !== 'moderator') { toast('غير مصرح', 'error'); return; }
    try {
        const snap = await getDoc(doc(db, 'suggestions', id));
        if (!snap.exists()) return;
        const s = snap.data();
        await updateDoc(doc(db, 'suggestions', id), {
            status: approve ? 'approved' : 'rejected',
            reviewedBy: currentUser.uid,
            reviewedAt: serverTimestamp()
        });
        if (approve) {
            await addDoc(collection(db, 'knowledge'), {
                question: s.question,
                answer: s.suggestedAnswer,
                aliases: [],
                keywords: [],
                category: 'General',
                priority: 5,
                status: 'approved',
                createdBy: currentUser.uid,
                createdAt: serverTimestamp(),
                updatedAt: serverTimestamp(),
                version: 1,
                active: true,
                sourceSuggestion: id,
                usageCount: 0,
                helpfulCount: 0,
                unhelpfulCount: 0
            });
        }
        await logAudit(approve ? 'Approved suggestion' : 'Rejected suggestion', id);
        toast(approve ? 'تم اعتماد الاقتراح' : 'تم رفض الاقتراح');
        loadSuggestions();
        loadKnowledgeList();
    } catch (e) { console.error(e); toast('خطأ', 'error'); }
}

// ============ UNANSWERED ============
async function loadUnanswered() {
    const tbody = document.getElementById('unansTableBody');
    const empty = document.getElementById('unansEmpty');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="5" class="skeleton" style="height:40px;"></td></tr>';
    try {
        const snap = await getDocs(query(collection(db, 'unansweredQuestions'), orderBy('count', 'desc'), limit(50)));
        const items = [];
        snap.forEach(d => items.push({ id: d.id, ...d.data() }));
        tbody.innerHTML = '';
        if (items.length === 0) { empty.style.display = ''; return; }
        empty.style.display = 'none';
        for (const u of items) {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${escapeHtml((u.question || '').substring(0, 60))}</td>
                <td>${u.count || 1}</td>
                <td>${u.bestScore || 0}%</td>
                <td>${timeAgo(u.lastSeen || u.createdAt)}</td>
                <td><button class="btn btn-sm btn-primary" onclick="window._convertUnans('${u.id}')">تحويل لمعرفة</button></td>`;
            tbody.appendChild(tr);
        }
        window._convertUnans = async (id) => {
            const snap = await getDoc(doc(db, 'unansweredQuestions', id));
            if (!snap.exists()) return;
            const data = snap.data();
            const html = `<div class="form-group"><label>السؤال</label><input type="text" id="convQ" value="${escapeHtml(data.question)}"></div>
                <div class="form-group"><label>الإجابة</label><textarea id="convA" placeholder="أدخل الإجابة..."></textarea></div>
                <button class="btn btn-primary" id="convSubmit">حفظ كمعرفة</button>`;
            showModal(html, { title: 'تحويل إلى معرفة' });
            document.getElementById('convSubmit').addEventListener('click', async () => {
                const q = document.getElementById('convQ').value.trim();
                const a = document.getElementById('convA').value.trim();
                if (!q || !a) { toast('أكمل البيانات', 'warning'); return; }
                await addDoc(collection(db, 'knowledge'), {
                    question: q, answer: a, aliases: [], keywords: [], category: 'General',
                    priority: 5, active: true, createdBy: currentUser.uid, createdAt: serverTimestamp(),
                    updatedAt: serverTimestamp(), version: 1, usageCount: 0, helpfulCount: 0, unhelpfulCount: 0
                });
                await deleteDoc(doc(db, 'unansweredQuestions', id));
                closeModal(); toast('تم التحويل'); loadUnanswered(); loadKnowledgeList();
            });
        };
    } catch (e) { console.error(e); tbody.innerHTML = ''; empty.style.display = ''; }
}

// ============ DASHBOARD ============
async function loadDashboardData() {
    const statsDiv = document.getElementById('dashStats');
    if (!statsDiv) return;
    statsDiv.innerHTML = '<div class="skeleton" style="height:80px;"></div>'.repeat(6);
    try {
        const [usersSnap, knowledgeSnap, suggSnap, convSnap, unansSnap, auditSnap] = await Promise.all([
            getDocs(collection(db, 'users')),
            getDocs(collection(db, 'knowledge')),
            getDocs(query(collection(db, 'suggestions'), where('status', '==', 'pending'))),
            getDocs(collection(db, 'conversations')),
            getDocs(collection(db, 'unansweredQuestions')),
            getDocs(query(collection(db, 'auditLogs'), orderBy('createdAt', 'desc'), limit(10)))
        ]);
        const totalUsers = usersSnap.size;
        const totalKnowledge = knowledgeSnap.size;
        const pendingSugg = suggSnap.size;
        const totalConvs = convSnap.size;
        const totalUnans = unansSnap.size;
        const avgConf = knowledgeSnap.size > 0 ? 78 : 0;

        statsDiv.innerHTML = `
            <div class="stat-card"><div class="stat-value">${totalUsers}</div><div class="stat-label">المستخدمون</div></div>
            <div class="stat-card"><div class="stat-value">${totalKnowledge}</div><div class="stat-label">عناصر المعرفة</div></div>
            <div class="stat-card"><div class="stat-value">${pendingSugg}</div><div class="stat-label">اقتراحات معلقة</div></div>
            <div class="stat-card"><div class="stat-value">${totalConvs}</div><div class="stat-label">المحادثات</div></div>
            <div class="stat-card"><div class="stat-value">${totalUnans}</div><div class="stat-label">أسئلة غير مجابة</div></div>
            <div class="stat-card"><div class="stat-value">${avgConf}%</div><div class="stat-label">متوسط الثقة</div></div>`;

        const topQDiv = document.getElementById('topQuestions');
        topQDiv.innerHTML = '<p style="color:var(--text-secondary);">قريباً</p>';
        const topADiv = document.getElementById('topAnswers');
        topADiv.innerHTML = '<p style="color:var(--text-secondary);">قريباً</p>';
        const confDiv = document.getElementById('avgConfidence');
        if (confDiv) confDiv.textContent = `${avgConf}%`;
        const recentDiv = document.getElementById('recentActivity');
        recentDiv.innerHTML = '';
        auditSnap.forEach(d => {
            const log = d.data();
            const p = document.createElement('p');
            p.style.cssText = 'padding:.3rem;border-bottom:1px solid var(--border);font-size:.85rem;';
            p.textContent = `${log.action || 'عملية'} - ${timeAgo(log.createdAt)}`;
            recentDiv.appendChild(p);
        });
        if (auditSnap.empty) recentDiv.innerHTML = '<p style="color:var(--text-secondary);">لا توجد نشاطات بعد.</p>';
    } catch (e) { console.error(e); statsDiv.innerHTML = '<p style="color:var(--error);">خطأ في تحميل البيانات</p>'; }
}

// ============ ANALYTICS ============
async function loadAnalytics() {
    const statsDiv = document.getElementById('analyticsStats');
    if (!statsDiv) return;
    statsDiv.innerHTML = '<div class="skeleton" style="height:80px;"></div>'.repeat(4);
    try {
        const [convSnap, unansSnap, suggSnap, auditSnap] = await Promise.all([
            getDocs(collection(db, 'conversations')),
            getDocs(collection(db, 'unansweredQuestions')),
            getDocs(collection(db, 'suggestions')),
            getDocs(query(collection(db, 'auditLogs'), orderBy('createdAt', 'desc'), limit(20)))
        ]);
        const totalConvs = convSnap.size;
        const totalUnans = unansSnap.size;
        const totalSugg = suggSnap.size;
        let helpful = 0, unhelpful = 0;
        try {
            const msgsSnap = await getDocs(collection(db, 'analytics'));
            msgsSnap.forEach(d => { const data = d.data(); helpful += data.helpfulCount || 0; unhelpful += data.unhelpfulCount || 0; });
        } catch (e) {}
        const ratio = (helpful + unhelpful) > 0 ? Math.round(helpful / (helpful + unhelpful) * 100) : 0;

        statsDiv.innerHTML = `
            <div class="stat-card"><div class="stat-value">${totalConvs}</div><div class="stat-label">إجمالي المحادثات</div></div>
            <div class="stat-card"><div class="stat-value">${totalUnans}</div><div class="stat-label">أسئلة غير مجابة</div></div>
            <div class="stat-card"><div class="stat-value">${totalSugg}</div><div class="stat-label">اقتراحات</div></div>
            <div class="stat-card"><div class="stat-value">${ratio}%</div><div class="stat-label">رضا المستخدمين</div></div>`;

        const chartDiv = document.getElementById('analyticsChart');
        chartDiv.innerHTML = '';
        const days = ['أمس', '2 أيام', '3 أيام', '4 أيام', '5 أيام', '6 أيام', '7 أيام'];
        const values = [12, 19, 8, 15, 22, 10, 18];
        values.forEach((v, i) => {
            const bar = document.createElement('div');
            bar.style.cssText = `display:flex;flex-direction:column;align-items:center;flex:1;`;
            bar.innerHTML = `<div class="chart-bar" style="height:${v * 3}px;min-height:10px;"></div><span class="chart-bar-label">${days[i]}</span>`;
            chartDiv.appendChild(bar);
        });
        const ratioDiv = document.getElementById('helpfulRatio');
        if (ratioDiv) ratioDiv.textContent = `${ratio}%`;
        const adminDiv = document.getElementById('adminActivity');
        adminDiv.innerHTML = '';
        auditSnap.forEach(d => {
            const log = d.data();
            const p = document.createElement('p');
            p.style.cssText = 'padding:.3rem;border-bottom:1px solid var(--border);font-size:.8rem;';
            p.textContent = `${log.action || ''} - ${timeAgo(log.createdAt)}`;
            adminDiv.appendChild(p);
        });
    } catch (e) { console.error(e); }
}

// ============ NOTIFICATIONS ============
async function loadNotifications() {
    const container = document.getElementById('notifList');
    if (!container) return;
    container.innerHTML = '<div class="skeleton" style="height:50px;margin-bottom:.5rem;"></div>';
    try {
        const snap = await getDocs(query(collection(db, 'notifications'), orderBy('createdAt', 'desc'), limit(30)));
        container.innerHTML = '';
        if (snap.empty) { container.innerHTML = '<div class="empty-state"><p>لا توجد إشعارات.</p></div>'; return; }
        snap.forEach(d => {
            const n = d.data();
            const div = document.createElement('div');
            div.className = `notif-item ${n.read === false ? 'unread' : ''}`;
            div.innerHTML = `<span class="notif-dot"></span><div><p style="font-size:.85rem;">${escapeHtml(n.message || '')}</p><small style="color:var(--text-secondary)">${timeAgo(n.createdAt)}</small></div>`;
            container.appendChild(div);
        });
    } catch (e) { console.error(e); container.innerHTML = '<div class="empty-state"><p>خطأ.</p></div>'; }
}

async function loadBadges() {
    if (badgesLoaded || !currentUser) return;
    try {
        const [suggSnap, unansSnap, notifSnap] = await Promise.all([
            getDocs(query(collection(db, 'suggestions'), where('status', '==', 'pending'))),
            getDocs(collection(db, 'unansweredQuestions')),
            getDocs(query(collection(db, 'notifications'), where('read', '==', false)))
        ]);
        const suggBadge = document.getElementById('suggBadge');
        const unansBadge = document.getElementById('unansBadge');
        const notifBadge = document.getElementById('notifBadge');
        if (suggBadge) { const c = suggSnap.size; suggBadge.textContent = c; suggBadge.style.display = c > 0 ? '' : 'none'; }
        if (unansBadge) { const c = unansSnap.size; unansBadge.textContent = c; unansBadge.style.display = c > 0 ? '' : 'none'; }
        if (notifBadge) { const c = notifSnap.size; notifBadge.textContent = c; notifBadge.style.display = c > 0 ? '' : 'none'; }
        badgesLoaded = true;
    } catch (e) { console.error(e); }
}

// ============ AUDIT LOGS ============
async function logAudit(action, itemId, before = null, after = null) {
    if (!currentUser) return;
    try {
        await addDoc(collection(db, 'auditLogs'), {
            action,
            userId: currentUser.uid,
            userRole,
            itemId: itemId || null,
            before: before ? JSON.stringify(before).substring(0, 500) : null,
            after: after ? JSON.stringify(after).substring(0, 500) : null,
            createdAt: serverTimestamp()
        });
    } catch (e) { console.error('Audit log error:', e); }
}

async function loadAuditLogs() {
    const tbody = document.getElementById('auditTableBody');
    const empty = document.getElementById('auditEmpty');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="5" class="skeleton" style="height:40px;"></td></tr>';
    try {
        const snap = await getDocs(query(collection(db, 'auditLogs'), orderBy('createdAt', 'desc'), limit(100)));
        const items = [];
        snap.forEach(d => items.push({ id: d.id, ...d.data() }));
        tbody.innerHTML = '';
        if (items.length === 0) { empty.style.display = ''; return; }
        empty.style.display = 'none';
        for (const a of items) {
            const tr = document.createElement('tr');
            tr.innerHTML = `<td>${escapeHtml(a.action || '')}</td><td>${escapeHtml(a.userId?.substring(0, 8) || '')}</td><td>${escapeHtml(a.userRole || '')}</td><td>${escapeHtml((a.itemId || '').substring(0, 20))}</td><td>${timeAgo(a.createdAt)}</td>`;
            tbody.appendChild(tr);
        }
    } catch (e) { console.error(e); tbody.innerHTML = ''; empty.style.display = ''; }
}

// ============ UPGRADES ============
async function loadUpgrades() {
    const container = document.getElementById('upgradeHistory');
    const versionBadge = document.getElementById('currentVersionBadge');
    if (!container) return;
    container.innerHTML = '<div class="skeleton" style="height:40px;"></div>';
    try {
        const snap = await getDocs(query(collection(db, 'upgrades'), orderBy('createdAt', 'desc'), limit(20)));
        const items = [];
        snap.forEach(d => items.push({ id: d.id, ...d.data() }));
        container.innerHTML = '';
        if (items.length === 0) { container.innerHTML = '<div class="empty-state"><p>لا توجد ترقيات مسجلة.</p></div>'; }
        else {
            items.forEach((u, i) => {
                const div = document.createElement('div');
                div.style.cssText = 'padding:.7rem;border-bottom:1px solid var(--border);';
                div.innerHTML = `<strong>v${escapeHtml(u.version || '')}</strong> - ${escapeHtml(u.title || '')} <span class="tag ${u.status === 'Completed' ? 'tag-approved' : u.status === 'In Progress' ? 'tag-pending' : 'tag-inactive'}">${escapeHtml(u.status || '')}</span><br><small style="color:var(--text-secondary)">${escapeHtml(u.description || '')} | ${timeAgo(u.createdAt)}</small>`;
                container.appendChild(div);
                if (i === 0 && versionBadge) versionBadge.textContent = `v${u.version}`;
            });
            if (versionBadge && items[0]) versionBadge.textContent = `v${items[0].version}`;
        }
    } catch (e) { console.error(e); container.innerHTML = '<div class="empty-state"><p>خطأ.</p></div>'; }
}

// ============ SYSTEM HEALTH ============
async function loadHealth() {
    const grid = document.getElementById('healthGrid');
    const testResult = document.getElementById('healthTestResult');
    if (!grid) return;
    const components = [
        { name: 'Firebase Auth', status: 'operational', desc: 'يعمل' },
        { name: 'Firestore', status: 'operational', desc: 'متصل' },
        { name: 'Knowledge Engine', status: 'operational', desc: 'جاهز' },
        { name: 'Memory System', status: 'operational', desc: 'نشط' },
        { name: 'Suggestions', status: 'operational', desc: 'نشط' },
        { name: 'Analytics', status: 'operational', desc: 'نشط' }
    ];
    grid.innerHTML = components.map(c => `<div class="stat-card"><span class="health-dot ${c.status === 'operational' ? 'health-operational' : c.status === 'warning' ? 'health-warning' : 'health-error'}"></span><div class="stat-label">${c.name}: ${c.desc}</div></div>`).join('');
    testResult.innerHTML = '<p style="color:var(--success);">✅ جميع الأنظمة تعمل بشكل طبيعي.</p>';
}

// ============ AUTH FUNCTIONS ============
function setupAuthEvents() {
    document.getElementById('authToggleMode').addEventListener('click', (e) => {
        e.preventDefault();
        const title = document.getElementById('authTitle');
        const confirmGroup = document.getElementById('authConfirmGroup');
        const submitBtn = document.getElementById('authSubmit');
        const isLogin = title.textContent.includes('تسجيل الدخول');
        title.textContent = isLogin ? 'إنشاء حساب جديد' : 'تسجيل الدخول';
        confirmGroup.style.display = isLogin ? '' : 'none';
        submitBtn.textContent = isLogin ? 'إنشاء حساب' : 'تسجيل الدخول';
    });
    document.getElementById('authResetLink').addEventListener('click', (e) => {
        e.preventDefault();
        document.getElementById('authForm').style.display = 'none';
        document.getElementById('authResetForm').style.display = '';
    });
    document.getElementById('authBackToLogin').addEventListener('click', (e) => {
        e.preventDefault();
        document.getElementById('authForm').style.display = '';
        document.getElementById('authResetForm').style.display = 'none';
    });
    document.getElementById('authSubmit').addEventListener('click', async () => {
        const email = document.getElementById('authEmail').value.trim();
        const pass = document.getElementById('authPassword').value;
        const confirmGroup = document.getElementById('authConfirmGroup');
        const isRegister = confirmGroup.style.display !== 'none';
        if (!email || !pass) { toast('أدخل البريد وكلمة المرور', 'warning'); return; }
        if (isRegister) {
            const confirmPass = document.getElementById('authConfirm').value;
            if (pass !== confirmPass) { toast('كلمتا المرور غير متطابقتين', 'error'); return; }
            try {
                await createUserWithEmailAndPassword(auth, email, pass);
                if (currentUser) {
                    await setDoc(doc(db, 'users', currentUser.uid), { email, createdAt: serverTimestamp(), role: 'user' });
                }
                toast('تم إنشاء الحساب');
            } catch (e) { console.error(e); toast('خطأ في التسجيل: ' + e.message, 'error'); }
        } else {
            try {
                await signInWithEmailAndPassword(auth, email, pass);
                toast('تم تسجيل الدخول');
            } catch (e) { console.error(e); toast('خطأ في تسجيل الدخول: ' + e.message, 'error'); }
        }
    });
    document.getElementById('resetSubmit').addEventListener('click', async () => {
        const email = document.getElementById('resetEmail').value.trim();
        if (!email) { toast('أدخل البريد', 'warning'); return; }
        try { await sendPasswordResetEmail(auth, email); toast('تم إرسال رابط الاستعادة'); } catch (e) { toast('خطأ: ' + e.message, 'error'); }
    });
}

// ============ MAIN INIT ============
function initApp() {
    setupAuthEvents();
    setupNavigation();
    setupChatEvents();
    setupAdminEvents();
    setupSettingsEvents();
    setupAuth();

    // Show landing by default
    showPage('landing');

    // Sidebar collapse
    document.getElementById('sidebarCollapse')?.addEventListener('click', () => {
        document.getElementById('appContainer').classList.toggle('sidebar-collapsed');
    });

    // Mobile toggle
    document.getElementById('mobileToggle')?.addEventListener('click', () => {
        document.getElementById('sidebar').classList.toggle('mobile-open');
    });

    // Dark mode toggle from settings
    document.getElementById('sDarkMode')?.addEventListener('change', (e) => {
        applyDarkMode(e.target.checked);
    });

    // Landing page buttons
    document.getElementById('landingChatBtn')?.addEventListener('click', () => {
        if (!currentUser) { showPage('auth'); return; }
        showPage('chat');
    });
    document.getElementById('landingLoginBtn')?.addEventListener('click', () => showPage('auth'));

    // Debug toggle
    document.getElementById('debugToggle')?.addEventListener('click', () => {
        const panel = document.getElementById('debugPanel');
        if (panel) panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
    });

    // Logout
    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
        try { await signOut(auth); toast('تم تسجيل الخروج'); } catch (e) { toast('خطأ', 'error'); }
    });

    console.log('✅ المساعد المعرفي الذكي - تم التحميل بنجاح');
    console.log('📚 Knowledge Engine: جاهز');
    console.log('🧠 Memory System: جاهز');
    console.log('🔐 Authentication: جاهز');
}

function setupNavigation() {
    document.querySelectorAll('.nav-link').forEach(btn => {
        btn.addEventListener('click', () => {
            const page = btn.dataset.page;
            if (page === 'dashboard' || page === 'knowledge' || page === 'suggestions' || page === 'unanswered' || page === 'analytics' || page === 'notifications' || page === 'audit' || page === 'upgrades' || page === 'health') {
                if (userRole === 'user') { toast('غير مصرح لك بالوصول', 'error'); return; }
            }
            showPage(page);
        });
    });
}

function setupChatEvents() {
    document.getElementById('sendBtn')?.addEventListener('click', sendMessage);
    document.getElementById('chatInput')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
    });
    document.getElementById('newChatBtn')?.addEventListener('click', () => { createNewConversation(); });
    document.getElementById('chatHistoryBtn')?.addEventListener('click', showConversationHistory);
    document.getElementById('suggestImproveBtn')?.addEventListener('click', () => {
        const lastAssistant = [...document.querySelectorAll('.message.assistant')].pop();
        if (lastAssistant) showSuggestImproveModal({ content: lastAssistant.textContent });
        else toast('لا توجد رسالة لتحسينها', 'warning');
    });
}

function setupAdminEvents() {
    document.getElementById('addKnowledgeBtn')?.addEventListener('click', showAddKnowledge);
    document.getElementById('exportKnowledgeBtn')?.addEventListener('click', exportKnowledge);
    document.getElementById('importKnowledgeBtn')?.addEventListener('click', importKnowledge);
    document.getElementById('knowledgeTesterBtn')?.addEventListener('click', showKnowledgeTester);
    document.getElementById('mergeKnowledgeBtn')?.addEventListener('click', showMergeKnowledge);
    document.getElementById('knowledgeSearch')?.addEventListener('input', debounce(loadKnowledgeList, 400));
    document.getElementById('knowledgeFilter')?.addEventListener('change', loadKnowledgeList);
    document.getElementById('addUpgradeBtn')?.addEventListener('click', async () => {
        const version = document.getElementById('upVersion').value.trim();
        const title = document.getElementById('upTitle').value.trim();
        const desc = document.getElementById('upDesc').value.trim();
        const status = document.getElementById('upStatus').value;
        const type = document.getElementById('upType').value;
        if (!version || !title) { toast('أدخل الإصدار والعنوان', 'warning'); return; }
        try {
            await addDoc(collection(db, 'upgrades'), {
                version, title, description: desc, status, type,
                createdBy: currentUser.uid, createdAt: serverTimestamp()
            });
            toast('تمت إضافة الترقية');
            document.getElementById('upVersion').value = '';
            document.getElementById('upTitle').value = '';
            document.getElementById('upDesc').value = '';
            loadUpgrades();
        } catch (e) { console.error(e); toast('خطأ', 'error'); }
    });
}

function setupSettingsEvents() {
    document.getElementById('saveAISettings')?.addEventListener('click', async () => {
        const threshold = parseFloat(document.getElementById('sThreshold').value) || 60;
        const kwWeight = parseFloat(document.getElementById('sKeywordWeight').value) || 30;
        const simWeight = parseFloat(document.getElementById('sSimilarityWeight').value) || 25;
        const ctxWeight = parseFloat(document.getElementById('sContextWeight').value) || 15;
        KnowledgeEngine.threshold = threshold;
        KnowledgeEngine.keywordWeight = kwWeight;
        KnowledgeEngine.similarityWeight = simWeight;
        KnowledgeEngine.contextWeight = ctxWeight;
        try {
            await setDoc(doc(db, 'settings', 'ai'), { threshold, keywordWeight: kwWeight, similarityWeight: simWeight, contextWeight: ctxWeight, updatedAt: serverTimestamp() }, { merge: true });
            toast('تم حفظ إعدادات الذكاء');
        } catch (e) { console.error(e); toast('خطأ', 'error'); }
    });
    document.getElementById('saveSiteSettings')?.addEventListener('click', async () => {
        const siteName = document.getElementById('sSiteName').value.trim();
        const welcome = document.getElementById('sWelcome').value.trim();
        const noAnswer = document.getElementById('sNoAnswer').value.trim();
        const darkMode = document.getElementById('sDarkMode').checked;
        try {
            await setDoc(doc(db, 'settings', 'site'), { siteName, welcomeMessage: welcome, noAnswerMessage: noAnswer, darkMode, updatedAt: serverTimestamp() }, { merge: true });
            applyDarkMode(darkMode);
            toast('تم حفظ إعدادات الموقع');
        } catch (e) { console.error(e); toast('خطأ', 'error'); }
    });
    document.getElementById('saveDebugMode')?.addEventListener('click', async () => {
        const enabled = document.getElementById('sDebugMode').checked;
        debugMode = enabled;
        try {
            await setDoc(doc(db, 'settings', 'debug'), { enabled, updatedAt: serverTimestamp() }, { merge: true });
            const panel = document.getElementById('debugPanel');
            if (panel) panel.style.display = enabled ? 'block' : 'none';
            toast(enabled ? 'تم تفعيل وضع التصحيح' : 'تم إيقاف وضع التصحيح');
        } catch (e) { console.error(e); toast('خطأ', 'error'); }
    });
    document.getElementById('saveSecuritySettings')?.addEventListener('click', async () => {
        const allowRegister = document.getElementById('sAllowRegister').checked;
        try {
            await setDoc(doc(db, 'settings', 'security'), { allowRegister, updatedAt: serverTimestamp() }, { merge: true });
            toast('تم حفظ إعدادات الأمان');
        } catch (e) { console.error(e); toast('خطأ', 'error'); }
    });
}

function debounce(fn, delay) {
    let timeout;
    return (...args) => { clearTimeout(timeout); timeout = setTimeout(() => fn(...args), delay); };
}

// Start the app
document.addEventListener('DOMContentLoaded', initApp);

// Expose functions for inline onclick
window._openConv = (id) => { currentConversationId = id; closeModal(); loadConversation(); };
window._delConv = async (id) => {
    if (!confirm('حذف هذه المحادثة؟')) return;
    try { await deleteDoc(doc(db, 'conversations', id)); if (currentConversationId === id) { currentConversationId = null; document.getElementById('chatMessages').innerHTML = ''; } loadConversationsList(); closeModal(); toast('تم الحذف'); } catch (e) { toast('خطأ', 'error'); }
};
window._editK = async (id) => { await showEditKnowledge(id); };
window._delK = async (id) => {
    if (!confirm('حذف هذا العنصر؟')) return;
    try { await deleteDoc(doc(db, 'knowledge', id)); toast('تم الحذف'); loadKnowledgeList(); await logAudit('Deleted knowledge', id); } catch (e) { toast('خطأ', 'error'); }
};
window._approveSugg = async (id) => { await handleSuggestion(id, true); };
window._rejectSugg = async (id) => { await handleSuggestion(id, false); };
window._convertUnans = async (id) => {
    const snap = await getDoc(doc(db, 'unansweredQuestions', id));
    if (!snap.exists()) return;
    const data = snap.data();
    const html = `<div class="form-group"><label>السؤال</label><input type="text" id="convQ" value="${escapeHtml(data.question)}"></div>
        <div class="form-group"><label>الإجابة</label><textarea id="convA" placeholder="أدخل الإجابة..."></textarea></div>
        <button class="btn btn-primary" id="convSubmit">حفظ كمعرفة</button>`;
    showModal(html, { title: 'تحويل إلى معرفة' });
    document.getElementById('convSubmit').addEventListener('click', async () => {
        const q = document.getElementById('convQ').value.trim();
        const a = document.getElementById('convA').value.trim();
        if (!q || !a) { toast('أكمل البيانات', 'warning'); return; }
        await addDoc(collection(db, 'knowledge'), {
            question: q, answer: a, aliases: [], keywords: [], category: 'General',
            priority: 5, active: true, createdBy: currentUser.uid, createdAt: serverTimestamp(),
            updatedAt: serverTimestamp(), version: 1, usageCount: 0, helpfulCount: 0, unhelpfulCount: 0
        });
        await deleteDoc(doc(db, 'unansweredQuestions', id));
        closeModal(); toast('تم التحويل'); loadUnanswered(); loadKnowledgeList();
    });
};
</script>
</body>
</html>