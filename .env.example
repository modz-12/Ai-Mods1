# انسخ هذا الملف باسم .env وعدّل القيم

# البورت اللي السيرفر هيشتغل عليه
PORT=3000

# كلمة سر لحماية الإضافة والحذف (سيبها فاضية = الموقع مفتوح للكل بدون حماية)
ADMIN_PASSWORD=change-me-please

# أقصى حجم للملف الواحد بالميجابايت
MAX_FILE_SIZE_MB=200

# اسم الموقع اللي هيظهر في الهيدر
SITE_NAME=المعرض
