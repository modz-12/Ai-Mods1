# =========================================================
# AI MODZ — Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file. NEVER put these values
# in any frontend file (public/*.js, public/*.html).
# =========================================================

# ---- Server ----
PORT=3000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API.
# For local dev this can be http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ---- Gemini (Google AI Studio) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any current Gemini model id, e.g. gemini-2.5-flash or gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash
# Set to "true" to let Gemini use its built-in Google Search grounding tool
# when local Knowledge is insufficient. If your API key/model does not
# support it, leave this "false" — the platform works fine without it.
GEMINI_ENABLE_SEARCH_TOOL=false

# ---- Firebase Admin (server-side, service account) ----
# Create this in Firebase Console -> Project Settings -> Service Accounts
# -> Generate new private key. Paste the path below OR inline the JSON
# via FIREBASE_SERVICE_ACCOUNT_JSON (useful for hosting providers that
# only accept env vars, e.g. Render/Railway).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
FIREBASE_PROJECT_ID=ai-modz

# ---- Bootstrap ----
# Used only once by `npm run set-owner` to promote the first Owner account.
OWNER_BOOTSTRAP_EMAIL=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
CHAT_RATE_LIMIT_MAX=20
