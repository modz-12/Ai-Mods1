rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH / ROLES
    // ============================================================
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function isModerator() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['moderator', 'admin', 'owner'];
    }

    function isStaff() {
      return isModerator();
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validRole(role) {
      return role in ['user', 'moderator', 'admin'];
    }

    // ============================================================
    // USERS
    // ============================================================
    match /users/{uid} {
      allow read: if signedIn() && (isOwner() || isSelf(uid));
      allow create: if isSelf(uid)
        && request.resource.data.role == 'user';
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'phone', 'themeColor', 'fontSize', 'darkMode', 'updatedAt']);
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['role', 'updatedAt']);
      allow delete: if isOwner();
    }

    // ============================================================
    // PUBLIC PROFILES
    // ============================================================
    match /profiles/{uid} {
      allow read: if true;
      allow create: if isSelf(uid);
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'bio', 'photoURL', 'updatedAt']);
      allow delete: if isSelf(uid) || isOwner();
    }

    // ============================================================
    // ADMINS / ROLES
    // Never allow a client to create or promote an owner.
    // ============================================================
    match /admins/{uid} {
      allow read: if isOwner() || (signedIn() && isSelf(uid));
      allow create: if isOwner()
        && uid != request.auth.uid
        && request.resource.data.role in ['moderator', 'admin'];
      allow update: if isOwner()
        && uid != request.auth.uid
        && request.resource.data.role in ['moderator', 'admin'];
      allow delete: if isOwner() && uid != request.auth.uid;
    }

    // ============================================================
    // KNOWLEDGE
    // Everyone signed-in can read active knowledge for the bot.
    // Staff can fully manage knowledge.
    // Normal users may ONLY increment usage/rating counters.
    // ============================================================
    match /knowledge/{knowledgeId} {
      allow read: if signedIn();
      allow create: if isStaff()
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isStaff();

      allow update: if isStaff();

      // Counter-only updates for normal signed-in users.
      allow update: if signedIn()
        && !isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['usageCount', 'helpfulCount', 'unhelpfulCount'])
        && request.resource.data.usageCount >= resource.data.usageCount
        && request.resource.data.helpfulCount >= resource.data.helpfulCount
        && request.resource.data.unhelpfulCount >= resource.data.unhelpfulCount;
    }

    match /knowledgeVersions/{versionId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isOwner();
    }

    // ============================================================
    // CONVERSATIONS
    // Owner of a conversation can read/write/delete it.
    // ============================================================
    match /conversations/{conversationId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isOwner());

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isOwner());

      match /messages/{messageId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid
              || isOwner());

        allow create: if signedIn()
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid
          && request.resource.data.role in ['user', 'assistant'];

        allow update: if signedIn()
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['rated', 'rating', 'ratedAt']);

        allow delete: if signedIn()
          && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid
              || isOwner());
      }
    }

    // ============================================================
    // UNANSWERED QUESTIONS
    // Users can create/update their unanswered questions.
    // Staff can manage/resolve them.
    // ============================================================
    match /unansweredQuestions/{questionId} {
      allow read: if isStaff();

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isStaff();

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['count', 'lastSeen']);

      allow delete: if isStaff()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // ============================================================
    // SUGGESTIONS
    // Anyone signed-in can submit. Staff can review.
    // ============================================================
    match /suggestions/{suggestionId} {
      allow read: if isStaff()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isStaff();
      allow delete: if isStaff()
        || (signedIn() && resource.data.userId == request.auth.uid
            && resource.data.status == 'pending');
    }

    // ============================================================
    // DIRECT MESSAGES
    // A DM can only be accessed by one of its two participants.
    // ============================================================
    match /dms/{dmId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'updatedAt']);

      allow delete: if signedIn()
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.participants;

        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.participants
          && request.resource.data.senderId == request.auth.uid;

        allow update, delete: if signedIn()
          && request.auth.uid == resource.data.senderId;
      }
    }

    // ============================================================
    // NOTIFICATIONS
    // Users may create unanswered-question notifications.
    // Only staff can read/manage the notification inbox.
    // ============================================================
    match /notifications/{notificationId} {
      allow read: if isStaff();
      allow create: if signedIn()
        && request.resource.data.type == 'unanswered'
        && request.resource.data.read == false;
      allow update, delete: if isStaff();
    }

    // ============================================================
    // AUDIT LOGS
    // Staff can read. Staff can create their own audit entries.
    // ============================================================
    match /auditLogs/{logId} {
      allow read: if isOwner();
      allow create: if isStaff()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner();
    }

    // ============================================================
    // SETTINGS
    // Public/site settings are readable by signed-in users.
    // AI/debug are staff-controlled. Site/security are owner-only.
    // ============================================================
    match /settings/{settingId} {
      allow read: if signedIn();

      allow create, update: if isOwner();

      allow create, update: if isStaff()
        && settingId in ['ai', 'debug'];

      allow delete: if isOwner();
    }

    // ============================================================
    // UPGRADES
    // Everyone signed-in can read; only owner can publish.
    // ============================================================
    match /upgrades/{upgradeId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner();
    }

    // ============================================================
    // FUTURE/UNKNOWN COLLECTIONS
    // Deny by default.
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
