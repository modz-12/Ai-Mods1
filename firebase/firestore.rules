rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}